---
import '../styles/scena.css';
import { asset } from '../utils/paths.js';
import { contactEmail, socialLinks } from '../data/site.js';

interface Props {
  title: string;
  description?: string;
  /** true → meta robots noindex,nofollow (použití: vlastní 404 stránka) */
  noindex?: boolean;
}

const { title, description = 'Historický a scénický šerm z Mohelnice. Umění, které přežívá století.', noindex = false } = Astro.props;

// Jeden zdroj pravdy pro URL: Astro.site z astro.config.mjs
// (produkce https://shsheretik.cz, GitHub Pages https://j31t4.github.io + base).
const siteURL = Astro.site ?? new URL('https://shsheretik.cz');
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(`${basePath}/images/opt/hero-1.jpg`, siteURL);

// Title bez dvojitého názvu webu (title už může obsahovat „SHŠ Heretik“).
const fullTitle = title.includes('SHŠ Heretik') ? title : `${title} | SHŠ Heretik`;

// JSON-LD — pouze ověřené údaje (produkční URL z configu, žádné vymyšlené kontakty).
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PerformingGroup',
  name: 'SHŠ Heretik',
  url: new URL(basePath || '/', siteURL).toString(),
  logo: new URL(`${basePath}/logo.svg`, siteURL).toString(),
  image: socialImageURL.toString(),
  email: contactEmail,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mohelnice',
    addressCountry: 'CZ',
  },
  sameAs: socialLinks.map((s) => s.href),
};
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A0A0A" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="cs_CZ" />
  <meta property="og:site_name" content="SHŠ Heretik" />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:width" content="1568" />
  <meta property="og:image:height" content="1024" />
  <meta property="og:image:alt" content="Šermířské vystoupení skupiny SHŠ Heretik" />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
  <link rel="manifest" href={asset('/site.webmanifest')} />
  {/* Preload jen kritických řezů: Fraunces (nadpisy/hero, latin + latin-ext) a Inter (tělo, latin) */}
  <link rel="preload" href={asset('/fonts/fraunces-latin-400_600.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={asset('/fonts/fraunces-latin-ext-400_600.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={asset('/fonts/inter-latin-400_600.woff2')} as="font" type="font/woff2" crossorigin />
  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />}
  <title>{fullTitle}</title>
  <script is:inline>
    // Progressive enhancement: animace se zapnou až po načtení JS.
    // Třída se přidá okamžitě (před prvním vykreslením), obsah je viditelný i bez JS.
    document.documentElement.classList.add('enhanced', 'js');
  </script>
</head>
<body>
  <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
  <div class="scene-grain" aria-hidden="true"></div>
  <div class="scene-vignette" aria-hidden="true"></div>
  <div class="scroll-progress" aria-hidden="true"></div>
  <slot />
  <script>
    import '../scripts/site.js';
    import '../scripts/reveal.js';
  </script>
</body>
</html>
