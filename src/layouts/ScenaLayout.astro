---
import '../styles/scena.css';
import { asset } from '../utils/paths.js';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Historický a scénický šerm z Mohelnice. Umění, které přežívá století.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A0A0A" />
  <meta property="og:title" content={`${title} | SHŠ Heretik`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={asset('/images/opt/hero-1-1600.jpg')} />
  <meta property="og:url" content="https://j31t4.github.io/heretik-web-scena/" />
  <link rel="icon" type="image/svg+xml" href={asset('/logo.svg')} />
  <link rel="preload" href={asset('/fonts/fraunces-latin-400_600.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={asset('/fonts/fraunces-latin-ext-400_600.woff2')} as="font" type="font/woff2" crossorigin />
  <title>{title} | SHŠ Heretik</title>
  <script is:inline>
    // Progressive enhancement: animace se zapnou až po načtení JS.
    // Třída se přidá okamžitě (před prvním vykreslením), obsah je viditelný i bez JS.
    document.documentElement.classList.add('enhanced');
  </script>
</head>
<body>
  <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
  <slot />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
