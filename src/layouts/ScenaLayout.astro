---
import '../styles/scena.css';
import { asset } from '../utils/paths.js';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Historický a scénický šerm z Mohelnice. Umění, které přežívá století.' } = Astro.props;
const siteURL = Astro.site ?? new URL('https://j31t4.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(asset('/images/opt/hero-1.jpg'), siteURL);
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A0A0A" />
  <meta property="og:title" content={`${title} | SHŠ Heretik`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="cs_CZ" />
  <meta property="og:site_name" content="SHŠ Heretik" />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:width" content="1568" />
  <meta property="og:image:height" content="1024" />
  <meta property="og:image:alt" content="Šermířské vystoupení skupiny SHŠ Heretik" />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href={asset('/logo.svg')} />
  <link rel="preload" href={asset('/fonts/fraunces-latin-400_600.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={asset('/fonts/fraunces-latin-ext-400_600.woff2')} as="font" type="font/woff2" crossorigin />
  <title>{title} | SHŠ Heretik</title>
  <script is:inline>
    // Progressive enhancement: animace se zapnou až po načtení JS.
    // Třída se přidá okamžitě (před prvním vykreslením), obsah je viditelný i bez JS.
    document.documentElement.classList.add('enhanced');
  </script>
</head>
<body>
  <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
  <slot />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
