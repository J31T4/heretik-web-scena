---
import { socialLinks, siteLocation } from '../data/site.js';

const instagram = socialLinks.find((social) => social.id === 'instagram');
---

<section class="scena-ig section" aria-labelledby="instagram-title">
  <div class="container ig__layout">
    <div class="ig__copy reveal">
      <p class="section-label">Ze zákulisí</p>
      <h2 class="ig__title" id="instagram-title">
        Aktuálně<br />
        <em>na Instagramu</em>
      </h2>
      <p class="ig__intro">
        Nejdřív se k nám dostanete na sociálních sítích — sledujte nás, ať vám neuteče žádné
        vystoupení ani nová fotka z našich akcí.
      </p>

      <a
        href={instagram.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary ig__cta"
      >
        Sledovat @heretik_z.s._ <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="ig__stage reveal reveal--delay-100">
      <div class="ig__stage-head" aria-hidden="true">
        <span class="ig__live"><i></i> Živě ze zákulisí</span>
        <span>@heretik_z.s._</span>
      </div>

      <div class="ig__frame">
        <iframe
          src="https://www.instagram.com/heretik_z.s._/embed/"
          title="Instagram — SHŠ Heretik"
          width="540"
          height="560"
          scrolling="no"
          loading="lazy"
        ></iframe>
      </div>

      <div class="ig__stage-foot" aria-hidden="true">
        <span>SHŠ Heretik</span>
        <span>{siteLocation}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .scena-ig {
    overflow: hidden;
    background:
      radial-gradient(ellipse 50% 80% at 92% 50%, rgba(228, 6, 7, 0.07), transparent 68%),
      var(--bg-0);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .scena-ig::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: clamp(3px, 0.45vw, 7px);
    background: linear-gradient(180deg, transparent 8%, var(--crimson) 42%, transparent 92%);
    opacity: 0.55;
  }

  .ig__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(460px, 1fr);
    gap: clamp(3rem, 8vw, 7.5rem);
    align-items: center;
  }

  .ig__copy { max-width: 500px; }

  .ig__title {
    font-size: clamp(2.8rem, 5.7vw, 5.3rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin-bottom: var(--sp-6);
  }

  .ig__title em {
    color: var(--ink-2);
    font-weight: 400;
  }

  .ig__intro {
    max-width: 44ch;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.8;
    color: var(--ink-2);
    padding-left: var(--sp-5);
    border-left: 2px solid var(--crimson);
    margin-bottom: var(--sp-6);
  }

  .ig__cta { min-width: min(100%, 285px); }

  .ig__stage {
    position: relative;
    width: 100%;
    max-width: 580px;
    justify-self: end;
    padding: 0.65rem;
    background:
      linear-gradient(145deg, rgba(242, 237, 228, 0.055), transparent 38%),
      var(--bg-2);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-2);
  }

  .ig__stage::before,
  .ig__stage::after {
    content: '';
    position: absolute;
    width: 54px;
    height: 54px;
    pointer-events: none;
    z-index: 1;
  }

  .ig__stage::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--crimson);
    border-left: 2px solid var(--crimson);
  }

  .ig__stage::after {
    right: -1px;
    bottom: -1px;
    border-right: 1px solid var(--gold-soft);
    border-bottom: 1px solid var(--gold-soft);
  }

  .ig__stage-head,
  .ig__stage-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 0.55rem 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ig__live {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--gold);
  }

  .ig__live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--crimson-bright);
    box-shadow: 0 0 12px var(--crimson-glow);
  }

  .ig__stage-foot {
    padding-top: 0.7rem;
    padding-bottom: 0.15rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
  }

  .ig__stage-foot span:first-child { color: var(--ink-2); }

  .ig__frame {
    /* Instagram iframe je cross-origin: světlou hlavičku proto skryjeme výřezem a ponecháme živou mřížku fotek. */
    --ig-profile-offset: 158px;
    position: relative;
    width: 100%;
    min-height: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-3);
    border: 1px solid rgba(242, 237, 228, 0.2);
  }

  .ig__frame iframe {
    display: block;
    position: absolute;
    top: calc(-1 * var(--ig-profile-offset));
    left: 0;
    width: 100%;
    max-width: 100%;
    height: calc(100% + var(--ig-profile-offset) + 2px);
    border: 0;
    background: #fff;
    color-scheme: light;
    filter: contrast(1.025) saturate(0.92);
    transition: filter var(--t-med) var(--ease);
  }

  .ig__stage:hover .ig__frame iframe,
  .ig__stage:focus-within .ig__frame iframe {
    filter: contrast(1.035) saturate(1.04);
  }

  @media (max-width: 980px) {
    .ig__layout {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }

    .ig__copy { max-width: 680px; }
    .ig__stage { justify-self: center; }
  }

  @media (max-width: 560px) {
    .ig__title { font-size: clamp(2.65rem, 14vw, 4rem); }
    .ig__intro { padding-left: var(--sp-4); }
    .ig__cta { width: 100%; min-width: 0; }
    .ig__stage { padding: 0.45rem; }
    .ig__frame { --ig-profile-offset: 147px; }
    .ig__stage-head,
    .ig__stage-foot { font-size: 0.59rem; letter-spacing: 0.11em; }
    .ig__stage-foot span:last-child { display: none; }
  }
</style>
