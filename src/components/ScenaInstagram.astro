---
import { socialLinks, siteLocation } from '../data/site.js';
import { cs } from '../utils/typo.js';
import Picture from './Picture.astro';

const instagram = socialLinks.find((social) => social.id === 'instagram');
const instagramFeedUrl = 'https://feeds.behold.so/2u1AIdMMoQAzZSje2ifl';
---

<section class="scena-ig section" aria-labelledby="instagram-title">
  <div class="container ig__layout">
    <div class="ig__copy reveal">
      <p class="section-label">Ze zákulisí</p>
      <h2 class="ig__title" id="instagram-title">
        Aktuálně<br />
        <em>{cs('na Instagramu')}</em>
      </h2>
      <p class="ig__intro">{cs('Novinky, fotky a dění ze zákulisí najdete nejdřív na našem Instagramu.')}</p>

      <a
        href={instagram.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary ig__cta"
      >
        Sledovat {instagram.handle} <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="ig__stage reveal reveal--delay-100">
      <div class="ig__stage-head" aria-hidden="true">
        <span class="ig__live"><i></i> Živě ze zákulisí</span>
        <span>{instagram.handle}</span>
      </div>

      <div
        class="ig__frame"
        data-instagram-feed
        data-feed-url={instagramFeedUrl}
        aria-busy="true"
      >
        <div class="ig__grid" aria-label="Nejnovější příspěvky SHŠ Heretik na Instagramu">
          {Array.from({ length: 6 }).map(() => <span class="ig__skeleton" aria-hidden="true"></span>)}
        </div>

        <p class="sr-only" data-instagram-status role="status" aria-live="polite"></p>

        <div class="ig__fallback" data-instagram-fallback hidden>
          <div class="ig__fallback-grid" aria-hidden="true">
            <Picture src="/images/opt/gallery-1.jpg" alt="" width={1400} height={666} loading="lazy" sizes="(max-width: 560px) 50vw, 240px" />
            <Picture src="/images/opt/gallery-3.jpg" alt="" width={1400} height={934} loading="lazy" sizes="(max-width: 560px) 50vw, 240px" />
            <Picture src="/images/opt/gallery-5.jpg" alt="" width={1050} height={1400} loading="lazy" sizes="(max-width: 560px) 50vw, 240px" />
          </div>
          <p class="ig__fallback-note">Novinky, fotky a dění ze zákulisí najdete na našem Instagramu.</p>
          <a
            href={instagram.href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary ig__fallback-cta"
          >
            Sledovat {instagram.handle} <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <noscript>
          <p class="ig__noscript">
            Pro zobrazení příspěvků zapněte JavaScript nebo
            <a href={instagram.href} target="_blank" rel="noopener noreferrer">otevřete Instagram</a>.
          </p>
        </noscript>
      </div>

      <div class="ig__stage-foot" aria-hidden="true">
        <span>SHŠ Heretik</span>
        <span>{siteLocation}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .scena-ig {
    overflow: hidden;
    background:
      radial-gradient(ellipse 50% 80% at 92% 50%, rgba(228, 6, 7, 0.07), transparent 68%),
      var(--bg-0);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .scena-ig::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: clamp(3px, 0.45vw, 7px);
    background: linear-gradient(180deg, transparent 8%, var(--crimson) 42%, transparent 92%);
    opacity: 0.55;
  }

  .ig__layout {
    display: grid;
    grid-template-columns: minmax(250px, 0.55fr) minmax(600px, 1.35fr);
    gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: center;
  }

  .ig__copy { max-width: 360px; }

  .ig__title {
    font-size: clamp(2.8rem, 4.3vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin-bottom: var(--sp-5);
  }

  .ig__title em {
    color: var(--ink-2);
    font-weight: 400;
    font-size: 0.72em;
  }

  .ig__intro {
    max-width: 34ch;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.65;
    color: var(--ink-2);
    padding-left: var(--sp-5);
    border-left: 2px solid var(--crimson);
    margin-bottom: var(--sp-5);
  }

  .ig__cta { min-width: min(100%, 285px); }

  .ig__stage {
    position: relative;
    width: 100%;
    max-width: 760px;
    justify-self: end;
    padding: 0.65rem;
    background:
      linear-gradient(145deg, rgba(242, 237, 228, 0.055), transparent 38%),
      var(--bg-2);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-2);
  }

  .ig__stage::before,
  .ig__stage::after {
    content: '';
    position: absolute;
    width: 54px;
    height: 54px;
    pointer-events: none;
    z-index: 1;
  }

  .ig__stage::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--crimson);
    border-left: 2px solid var(--crimson);
  }

  .ig__stage::after {
    right: -1px;
    bottom: -1px;
    border-right: 1px solid var(--gold-soft);
    border-bottom: 1px solid var(--gold-soft);
  }

  .ig__stage-head,
  .ig__stage-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 0.55rem 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ig__live {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--gold);
  }

  .ig__live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--crimson-bright);
    box-shadow: 0 0 12px var(--crimson-glow);
  }

  .ig__stage-foot {
    padding-top: 0.7rem;
    padding-bottom: 0.15rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
  }

  .ig__stage-foot span:first-child { color: var(--ink-2); }

  .ig__frame {
    position: relative;
    width: 100%;
    min-height: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-3);
    border: 1px solid rgba(242, 237, 228, 0.2);
  }

  .ig__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    height: 100%;
    gap: 2px;
    background: var(--line-2);
  }

  .ig__grid[hidden] { display: none; }

  .ig__skeleton {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(145deg, rgba(242, 237, 228, 0.035), transparent 55%),
      var(--bg-2);
  }

  .ig__skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(242, 237, 228, 0.06), transparent);
    animation: ig-shimmer 1.8s ease-in-out infinite;
  }

  .ig__grid :global(.ig__post) {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--bg-2);
    color: var(--ink);
    isolation: isolate;
  }

  .ig__grid :global(.ig__post::after) {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 48%, rgba(9, 8, 8, 0.82));
    opacity: 0.32;
    transition: opacity var(--t-med) var(--ease);
  }

  .ig__grid :global(.ig__post-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: saturate(0.88) contrast(1.04);
    transform: scale(1.002);
    transition:
      opacity var(--t-med) var(--ease),
      filter var(--t-med) var(--ease),
      transform 600ms var(--ease);
  }

  .ig__grid :global(.ig__post-image.is-ready) { opacity: 1; }

  .ig__grid :global(.ig__post-mark),
  .ig__grid :global(.ig__post-label) {
    position: absolute;
    z-index: 2;
    font-family: var(--font-ui);
    text-transform: uppercase;
  }

  /* Placeholder pro nenačtený obrázek — tmavý, ladí s designem */
  .ig__grid :global(.ig__post-placeholder) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      linear-gradient(145deg, rgba(242, 237, 228, 0.04), transparent 55%),
      var(--bg-3);
    color: var(--ink-3);
    font-size: 1.4rem;
  }

  .ig__grid :global(.ig__post-mark) {
    top: 0.55rem;
    right: 0.55rem;
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border: 1px solid rgba(242, 237, 228, 0.42);
    background: rgba(9, 8, 8, 0.7);
    color: var(--ink);
    font-size: 0.66rem;
    line-height: 1;
    backdrop-filter: blur(5px);
  }

  .ig__grid :global(.ig__post-mark--video) {
    padding-left: 0.12rem;
    color: var(--crimson-bright);
  }

  .ig__grid :global(.ig__post-label) {
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.55rem;
    overflow: hidden;
    color: var(--ink);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity var(--t-med) var(--ease),
      transform var(--t-med) var(--ease);
  }

  .ig__grid :global(.ig__post:focus-visible::after) { opacity: 0.9; }
  .ig__grid :global(.ig__post:focus-visible .ig__post-image) {
    filter: saturate(1.04) contrast(1.06);
    transform: scale(1.045);
  }
  .ig__grid :global(.ig__post:focus-visible .ig__post-label) {
    opacity: 1;
    transform: translateY(0);
  }
  @media (hover: hover) and (pointer: fine) {
    .ig__grid :global(.ig__post:hover::after) { opacity: 0.9; }
    .ig__grid :global(.ig__post:hover .ig__post-image) {
      filter: saturate(1.04) contrast(1.06);
      transform: scale(1.045);
    }
    .ig__grid :global(.ig__post:hover .ig__post-label) {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ig__fallback,
  .ig__noscript {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: var(--sp-6);
    background:
      linear-gradient(rgba(9, 8, 8, 0.78), rgba(9, 8, 8, 0.92)),
      var(--bg-2);
  }

  .ig__fallback:not([hidden]),
  .ig__noscript { display: grid; }

  .ig__noscript {
    place-content: center;
    text-align: center;
    font-family: var(--font-ui);
    color: var(--ink-2);
  }

  .ig__fallback {
    grid-template-rows: 1fr auto auto;
    gap: var(--sp-4);
    align-content: center;
  }
  .ig__fallback-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    background: var(--line-2);
  }
  .ig__fallback-grid :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
  }
  .ig__fallback-note {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-align: center;
  }
  .ig__fallback-cta { justify-self: center; }

  .ig__fallback a,
  .ig__noscript a {
    color: var(--crimson-bright);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Visually hidden — pro stavový role="status" (čte se, nezabírá místo) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes ig-shimmer {
    55%,
    100% { transform: translateX(100%); }
  }

  @media (max-width: 980px) {
    .ig__layout {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }

    .ig__copy { max-width: 620px; }
    .ig__stage { justify-self: center; }
  }

  @media (max-width: 560px) {
    .ig__title { font-size: clamp(2.65rem, 14vw, 4rem); }
    .ig__intro { padding-left: var(--sp-4); }
    .ig__cta { width: 100%; min-width: 0; }
    .ig__stage { padding: 0.45rem; }
    .ig__frame { aspect-ratio: 2 / 3; }
    .ig__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ig__stage-head,
    .ig__stage-foot { font-size: 0.59rem; letter-spacing: 0.11em; }
    .ig__stage-foot span:last-child { display: none; }

    .ig__grid :global(.ig__post-label) { display: none; }
    .ig__grid :global(.ig__post-mark) {
      top: 0.35rem;
      right: 0.35rem;
      width: 1.4rem;
      height: 1.4rem;
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ig__skeleton::after { animation: none; }
    .ig__grid :global(.ig__post-image),
    .ig__grid :global(.ig__post-label) { transition: none; }
  }
</style>

<script>
  const CACHE_KEY = 'heretik-instagram-feed-v1';
  const CACHE_TTL = 60 * 60 * 1000;

  // Přístupné jméno (aria-label) odkazu se nesmí rovnat alt obrázku.
  // Tvoříme ho z typu příspěvku + captionu, stručně, s upozorněním na nový panel.
  const getPostLabel = (post, isVideo) => {
    const kind = isVideo ? 'video' : 'příspěvek';
    const firstLine = String(post?.caption ?? '').split('\n')[0].replace(/\s+/g, ' ').trim();
    const topic = firstLine ? ` — ${firstLine.slice(0, 60)}${firstLine.length > 60 ? '…' : ''}` : '';
    return `${kind} SHŠ Heretik${topic} (otevře se v novém okně)`;
  };

  const getCachedFeed = () => {
    try {
      const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) ?? 'null');
      return cached && Date.now() - cached.savedAt < CACHE_TTL ? cached.data : null;
    } catch {
      return null;
    }
  };

  const cacheFeed = (data) => {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ savedAt: Date.now(), data }));
    } catch {
      // Feed funguje i v prohlížečích, které blokují sessionStorage.
    }
  };

  const getImageUrl = (post) =>
    post?.sizes?.medium?.mediaUrl ?? post?.sizes?.small?.mediaUrl ?? post?.thumbnailUrl ?? post?.mediaUrl;

  const getAltText = (post) => {
    const firstLine = String(post?.caption ?? '').split('\n')[0].replace(/\s+/g, ' ').trim();
    if (!firstLine) return 'Příspěvek SHŠ Heretik na Instagramu';
    return `Instagram SHŠ Heretik: ${firstLine.slice(0, 120)}${firstLine.length > 120 ? '…' : ''}`;
  };

  const buildPost = (post) => {
    const isVideo = post.mediaType === 'VIDEO';
    const link = document.createElement('a');
    link.className = 'ig__post';
    link.href = post.permalink;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.ariaLabel = getPostLabel(post, isVideo);

    const image = document.createElement('img');
    image.className = 'ig__post-image';
    image.src = getImageUrl(post);
    image.alt = getAltText(post);
    image.loading = 'lazy';
    image.decoding = 'async';
    image.addEventListener('load', () => image.classList.add('is-ready'), { once: true });
    if (image.complete) image.classList.add('is-ready');

    // Chyba načtení jednoho obrázku → stylovaný placeholder v tmavém designu.
    const placeholder = document.createElement('span');
    placeholder.className = 'ig__post-placeholder';
    placeholder.textContent = isVideo ? '▶' : '↗';
    placeholder.setAttribute('aria-hidden', 'true');

    image.addEventListener(
      'error',
      () => {
        image.remove();
        link.append(placeholder);
      },
      { once: true }
    );

    const mark = document.createElement('span');
    mark.className = `ig__post-mark${isVideo ? ' ig__post-mark--video' : ''}`;
    mark.textContent = isVideo ? '▶' : '↗';
    mark.setAttribute('aria-hidden', 'true');

    const label = document.createElement('span');
    label.className = 'ig__post-label';
    label.textContent = isVideo ? 'Přehrát reel' : 'Zobrazit příspěvek';
    label.setAttribute('aria-hidden', 'true');

    link.append(image, placeholder, mark, label);
    return link;
  };

  const loadFeed = async (root) => {
    const grid = root.querySelector('.ig__grid');
    const fallback = root.querySelector('[data-instagram-fallback]');
    const status = root.querySelector('[data-instagram-status]');

    try {
      let data = getCachedFeed();
      if (!data) {
        const response = await fetch(root.dataset.feedUrl, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(`Behold feed: ${response.status}`);
        data = await response.json();
        cacheFeed(data);
      }

      const posts = Array.isArray(data?.posts)
        ? data.posts.filter((post) => post?.permalink && getImageUrl(post)).slice(0, 6)
        : [];
      if (!posts.length) throw new Error('Behold feed neobsahuje žádné příspěvky.');

      grid.replaceChildren(...posts.map(buildPost));
      if (status) status.textContent = 'Instagram feed se načetl.';
    } catch (error) {
      console.warn('Instagram feed se nepodařilo načíst.', error);
      grid.setAttribute('hidden', '');
      fallback?.removeAttribute('hidden');
      if (status) status.textContent = 'Instagram feed se nepodařilo načíst.';
    } finally {
      root.removeAttribute('aria-busy');
    }
  };

  document.querySelectorAll('[data-instagram-feed]').forEach((root) => {
    if (!('IntersectionObserver' in window)) {
      loadFeed(root);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        loadFeed(root);
      },
      { rootMargin: '400px 0px' },
    );
    observer.observe(root);
  });
</script>
