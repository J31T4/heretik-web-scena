---
const facts = [
  { value: '2020', label: 'Vznik spolku' },
  { value: 'Mohelnice', label: 'Naše domovská scéna' },
  { value: 'ČR', label: 'Rádi cestujeme' },
];
---

<section class="scena-quote act-section section--framed section">
  <span class="act-node" aria-hidden="true"></span>
  <div class="container">
    <p class="act-label act-label--center reveal">II. dějství · Kdo jsme</p>

    <div class="quote__stage">
      <span class="quote__mark" aria-hidden="true">„</span>

      <blockquote class="quote__text reveal">
        Jsme skupina umělců specializující se na historický a scénický šerm.
        Snažíme se oživit dávné bojové umění a přenést ho do současnosti
        prostřednictvím vystoupení a lekcí.
      </blockquote>

      <p class="quote__author reveal">— <span class="fire-text">SHŠ Heretik</span></p>

      <div class="quote__facts">
        {facts.map((fact) => (
          <div class="fact reveal">
            <span class="fact__value">{fact.value}</span>
            <span class="fact__label">{fact.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="grain" aria-hidden="true"></div>
</section>

<style>
  .scena-quote {
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 80% at 50% 115%, rgba(228, 6, 7, 0.1), transparent 62%),
      radial-gradient(ellipse 40% 60% at 50% -10%, rgba(153, 161, 168, 0.07), transparent 60%),
      var(--bg);
  }

  .scena-quote .container { position: relative; z-index: 1; }

  .quote__stage { max-width: 860px; margin: 0 auto; }

  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(7rem, 16vw, 12rem);
    line-height: 0.4;
    color: var(--crimson);
    opacity: 0.42;
    margin-bottom: var(--sp-7);
    text-shadow: 0 0 80px var(--crimson-glow);
  }

  .quote__text {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.4vw, 2.35rem);
    line-height: 1.42;
    color: var(--ink);
    margin: 0 auto var(--sp-6);
    max-width: 760px;
  }
  .quote__text::first-letter { color: var(--crimson-bright); }

  .quote__author {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: var(--sp-8);
  }

  .quote__facts {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: var(--sp-6) 0;
  }

  .fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 1;
    padding: 0 var(--sp-5);
    position: relative;
  }
  .fact + .fact { border-left: 1px solid var(--line-2); }
  .fact + .fact::before {
    content: '◆';
    position: absolute;
    left: -5px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.55rem;
    color: var(--crimson);
    background: var(--bg);
    padding: 0 1px;
  }

  .fact__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    line-height: 1;
    color: var(--gold);
  }
  .fact__label {
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-align: center;
  }

  @media (max-width: 640px) {
    .quote__facts { flex-direction: column; gap: var(--sp-5); }
    .fact + .fact { border-left: none; border-top: 1px solid var(--line-2); padding-top: var(--sp-5); }
    .fact + .fact::before { display: none; }
    .quote__mark { margin-bottom: var(--sp-6); }
  }
</style>
