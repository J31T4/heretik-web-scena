---
import Blade from './Blade.astro';
import { cs } from '../utils/typo.js';
import { page } from '../utils/paths.js';

const facts = [
  { value: '2020', label: 'Vznik spolku' },
  { value: 'Mohelnice', label: 'Naše domovská scéna' },
  { value: 'ČR', label: 'Rádi cestujeme' },
];
---

<section class="scena-quote act-section paper section" id="kdo-jsme">
  <span class="act-node" aria-hidden="true"></span>
  <div class="container">
    <p class="kicker kicker--center reveal"><span class="kicker__act">II. dějství</span><span class="kicker__label">Kdo jsme</span></p>

    <div class="quote__stage">
      <span class="quote__mark" aria-hidden="true">„</span>

      <blockquote class="quote__text reveal">{cs('Jsme skupina umělců specializující se na historický a scénický šerm. Snažíme se oživit dávné bojové umění a přenést ho do současnosti prostřednictvím vystoupení a lekcí.')}</blockquote>

      <Blade center class="quote__blade" />
      <p class="quote__author reveal">SHŠ Heretik</p>

      <div class="quote__facts" data-reveal-group>
        {facts.map((fact) => (
          <div class="fact" data-reveal>
            <span class="fact__value">{fact.value}</span>
            <span class="fact__label">{fact.label}</span>
          </div>
        ))}
      </div>

      <p class="quote__more reveal">
        <a href={page('/o-nas')} class="btn btn--ghost">Náš příběh <span class="btn__arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
  <div class="grain" aria-hidden="true"></div>
</section>

<style>
  .scena-quote {
    text-align: center;
    overflow: hidden;
    border-block: 1px solid var(--color-paper-2);
  }
  .scena-quote :global(.act-node) { background: var(--color-paper); }
  .scena-quote .container { position: relative; z-index: 1; }

  .quote__stage { max-width: 900px; margin: 0 auto; }

  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(8rem, 18vw, 14rem);
    line-height: 0.5;
    height: 0.42em;
    color: var(--color-paper-crimson);
    opacity: 0.9;
    margin-top: var(--sp-6);
    margin-bottom: clamp(2.5rem, 7vw, 5rem);
  }

  .quote__text {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.55rem, 3.6vw, 2.6rem);
    line-height: 1.36;
    letter-spacing: -0.01em;
    color: var(--color-paper-ink);
    margin: 0 auto var(--sp-6);
    max-width: 780px;
  }

  .quote__stage :global(.quote__blade) { margin-bottom: var(--sp-4); }

  .quote__author {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-paper-crimson);
    margin-bottom: var(--sp-8);
  }

  .quote__facts {
    display: flex;
    justify-content: center;
    align-items: stretch;
    border-top: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line-2);
    padding: var(--sp-6) 0;
  }

  .fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex: 1;
    padding: 0 var(--sp-5);
    position: relative;
  }
  .fact + .fact { border-left: 1px solid var(--line-2); }
  .fact + .fact::before {
    content: '';
    position: absolute;
    left: -3.5px;
    top: 50%;
    width: 6px;
    height: 6px;
    background: var(--color-paper-crimson);
    transform: translateY(-50%) rotate(45deg);
    box-shadow: 0 0 0 4px var(--color-paper);
  }

  .fact__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1;
    color: var(--color-paper-ink);
  }
  .fact__label {
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-paper-ink-2);
    text-align: center;
  }

  .quote__more { margin-top: var(--sp-7); }

  @media (max-width: 640px) {
    .quote__facts { flex-direction: column; gap: var(--sp-5); }
    .fact + .fact { border-left: none; border-top: 1px solid var(--line-2); padding-top: var(--sp-5); }
    .fact + .fact::before { display: none; }
  }
</style>
