---
const words = ['ŠERM', 'DIVADLO', 'PŘÍBĚH', 'CHOREOGRAFIE', 'HISTORIE', 'VÁŠEŇ', 'SCÉNA'];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track marquee__track--top">
    {[...words, ...words, ...words, ...words].map((w) => (
      <span><span class="dot">◆</span>{w}</span>
    ))}
  </div>
  <div class="marquee__track marquee__track--bottom">
    {[...words, ...words, ...words, ...words].map((w) => (
      <span><span class="dot">✦</span>{w}</span>
    ))}
  </div>
</div>

<!-- (styl v src/styles/scena.css — marquee je součást design systému) -->
