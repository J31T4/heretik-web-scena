---
import { asset } from '../utils/paths.js';

const images = [
  { src: 'gallery-1', caption: 'Tábořiště', area: 'g1' },
  { src: 'gallery-2', caption: 'Stanové ležení', area: 'g2' },
  { src: 'gallery-3', caption: 'Souboj', area: 'g3' },
  { src: 'gallery-4', caption: 'Dobové rekvizity', area: 'g4' },
  { src: 'gallery-5', caption: 'Ležení a ohniště', area: 'g5' },
  { src: 'gallery-6', caption: 'Před hradní zdí', area: 'g6' },
  { src: 'gallery-7', caption: 'Celá skupina', area: 'g7' },
  { src: 'gallery-8', caption: 'Skupinová fotografie', area: 'g8' },
];
---

<section class="scena-gallery act-section section section--tint">
  <span class="act-node" aria-hidden="true"></span>
  <div class="container">
    <p class="act-label reveal">III. dějství</p>
    <div class="section-head reveal">
      <p class="section-label">Galerie</p>
      <h2 class="section-title">Scény z představení</h2>
      <p class="section-subtitle">Výřezy z našich vystoupení a akcí. Kliknutím fotku zvětšíte.</p>
    </div>

    <div class="gallery__grid">
      {images.map((img, i) => (
        <button
          type="button"
          class:list={['gallery__item', 'reveal', { 'gallery__item--feat': i === 0 }]}
          style={`grid-area: ${img.area}`}
          data-lightbox
          data-caption={`Scéna ${String(i + 1).padStart(2, '0')} — ${img.caption}`}
          aria-label={`Zvětšit fotografii: Scéna ${String(i + 1).padStart(2, '0')} — ${img.caption}`}
        >
          <picture>
            <source srcset={asset(`/images/opt/${img.src}.webp`)} type="image/webp" />
            <img
              src={asset(`/images/opt/${img.src}.jpg`)}
              alt={`Scéna ${String(i + 1).padStart(2, '0')} — ${img.caption}`}
              loading="lazy"
              decoding="async"
              width="1400"
              height="1000"
            />
          </picture>
          <span class="gallery__plate">
            <span class="gallery__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="gallery__cap">{img.caption}</span>
          </span>
          <span class="gallery__zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
            </svg>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Zvětšená fotografie">
    <button type="button" class="lightbox__btn lightbox__close" id="lightboxClose" aria-label="Zavřít galerii">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__prev" id="lightboxPrev" aria-label="Předchozí fotografie">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <figure class="lightbox__stage">
      <img id="lightboxImg" alt="" />
      <figcaption class="lightbox__meta">
        <span id="lightboxCaption"></span>
        <span id="lightboxCounter" class="lightbox__counter" aria-live="polite"></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__next" id="lightboxNext" aria-label="Další fotografie">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</section>

<style>
  .scena-gallery { background: var(--bg); }

  /* --- Mozaikový grid (intencionální asymetrie, žádné díry) --- */
  .gallery__grid {
    display: grid;
    grid-template-areas:
      'g1 g1 g2 g3'
      'g1 g1 g2 g4'
      'g5 g6 g6 g4'
      'g5 g7 g7 g8';
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(150px, 15vw, 205px);
    gap: clamp(0.7rem, 1.6vw, 1.1rem);
  }

  .gallery__item {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    text-align: left;
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
    background: var(--bg-3);
    transition: transform var(--t-med) var(--ease-out);
  }
  .gallery__item:hover { transform: translateY(-3px); }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    display: block;
    filter: saturate(0.88) contrast(1.05);
    transition: transform 0.7s var(--ease-out), filter var(--t-med) var(--ease);
  }
  .gallery__item:nth-child(7) img { object-position: center 18%; }
  .gallery__item:hover img,
  .gallery__item:focus-visible img {
    transform: scale(1.045);
    filter: saturate(1.05) contrast(1.08);
  }

  /* Popisek — vždy viditelný (nezávislý na hoveru) */
  .gallery__plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 2.4rem 0.9rem 0.75rem;
    background: linear-gradient(180deg, transparent, rgba(6, 6, 6, 0.88));
    color: var(--ink);
  }
  .gallery__num {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--crimson-bright);
  }
  .gallery__cap {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gallery__zoom {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    border: 1px solid var(--line-2);
    background: rgba(6, 6, 6, 0.5);
    opacity: 0;
    transition: opacity var(--t-med) var(--ease), color var(--t-med) var(--ease);
  }
  .gallery__item:hover .gallery__zoom,
  .gallery__item:focus-visible .gallery__zoom { opacity: 1; }
  .gallery__zoom:hover { color: var(--crimson-bright); }

  /* --- Lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-lightbox);
    background: rgba(4, 4, 4, 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--t-med) var(--ease), visibility 0s linear var(--t-med);
    cursor: zoom-out;
  }
  .lightbox.open {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--t-med) var(--ease), visibility 0s;
  }

  .lightbox__stage {
    margin: 0;
    max-width: min(92vw, 1200px);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .lightbox__stage img {
    max-width: 92vw;
    max-height: 76vh;
    object-fit: contain;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-2);
    background: #000;
  }
  .lightbox__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .lightbox__counter { color: var(--crimson-bright); letter-spacing: 0.3em; }

  .lightbox__btn {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    color: var(--ink);
    border: 1px solid var(--line-2);
    background: rgba(10, 10, 10, 0.6);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .lightbox__btn:hover {
    color: var(--crimson-bright);
    border-color: var(--crimson);
    background: rgba(228, 6, 7, 0.08);
  }
  .lightbox__close { top: 1.4rem; right: 1.4rem; }
  .lightbox__prev { left: 1.4rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 1.4rem; top: 50%; transform: translateY(-50%); }

  @media (max-width: 1024px) {
    .gallery__grid {
      grid-template-areas:
        'g1 g1'
        'g2 g3'
        'g4 g5'
        'g6 g7'
        'g8 g8';
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: auto;
    }
    .gallery__item { aspect-ratio: 4 / 3; }
    .gallery__item img { position: absolute; inset: 0; }
    .lightbox__prev, .lightbox__next {
      top: auto;
      bottom: 1.2rem;
      transform: none;
      width: 48px;
      height: 48px;
    }
    .lightbox__prev { left: 1.2rem; }
    .lightbox__next { right: 1.2rem; }
    .lightbox__stage img { max-height: 70vh; }
  }
  @media (max-width: 560px) {
    .gallery__grid {
      grid-template-areas:
        'g1'
        'g2'
        'g3'
        'g4'
        'g5'
        'g6'
        'g7'
        'g8';
      grid-template-columns: 1fr;
    }
  }
</style>
