---
import Picture from './Picture.astro';
import Blade from './Blade.astro';
import { asset, page } from '../utils/paths.js';
import { cs } from '../utils/typo.js';

interface Props {
  act?: string;
  /** Rozšířená galerie se všemi nejnovějšími fotkami (stránka Galerie);
   *  domů zůstává jen kurátorský výběr, kam přijde video. */
  extended?: boolean;
}

const { act = 'III. dějství', extended = false } = Astro.props;

// Texty `alt` slouží jen čtečkám obrazovky — v galerii se nikde nezobrazují.
const images = [
  { src: 'gallery-1', alt: 'Tábořiště s dobovými stany, stolem a vybavením', area: 'g1', w: 1400, h: 666 },
  { src: 'gallery-2', alt: 'Stanové ležení s dřevěným nábytkem a nádobím', area: 'g2', w: 1400, h: 915 },
  { src: 'gallery-21', alt: 'Usměvavý šermíř ve fialovém kabátě zkříží čepel se soupeřem', area: 'g3', w: 1400, h: 932 },
  { src: 'gallery-20', alt: 'Šermíř ve zlatozelené vestě s mečem u plotu hřiště', area: 'g4', w: 1400, h: 932 },
  { src: 'gallery-5', alt: 'Dobové ležení se stanem a postavou v červeném kostýmu', area: 'g5', w: 1050, h: 1400 },
  { src: 'gallery-9', alt: 'Šermíři v kostýmech na trávníku před hradbou a stany', area: 'g6', w: 1400, h: 646 },
  { src: 'gallery-11', alt: 'Skupinový souboj na trávníku, v pozadí stany a hradba', area: 'g7', w: 1400, h: 646 },
  { src: 'gallery-23', alt: 'Dva šermíři v těsném souboji, jeden s mečem u země', area: 'g8', w: 1400, h: 932 },
];

// Zbytek fotek ze sezóny 2026 — jen v rozšířené galerii na /galerie.
// `cols` × `rows` = velikost dlaždice v šestisloupcovém rytmu (dohromady bez děr).
const extraImages = [
  { src: 'gallery-10', alt: 'Souboj dvojice šermířů před barevnými stany pod hradbou', cols: 4, rows: 2, w: 1400, h: 646 },
  { src: 'gallery-12', alt: 'Dva souboje najednou na nádvoří dobového ležení', cols: 2, rows: 1, w: 1400, h: 646 },
  { src: 'gallery-13', alt: 'Šermířské vystoupení před diváky na městském nádvoří', cols: 2, rows: 1, w: 1400, h: 646 },
  { src: 'gallery-14', alt: 'Dva členové skupiny v dobových kostýmech před hradbou', cols: 2, rows: 2, w: 646, h: 1400 },
  { src: 'gallery-16', alt: 'Šermíř v předklonu proti soupeři, v pozadí ležení a diváci', cols: 4, rows: 1, w: 1400, h: 646 },
  { src: 'gallery-17', alt: 'Dva šermíři se střetávají meči před stanem', cols: 2, rows: 1, w: 1400, h: 646 },
  { src: 'gallery-18', alt: 'Šermíři v pohybu na trávníku, v pozadí barevný stan', cols: 2, rows: 1, w: 1400, h: 646 },
  { src: 'gallery-19', alt: 'Večerní vystoupení na pódiu před publikem na náměstí', cols: 3, rows: 2, w: 1400, h: 788 },
  { src: 'gallery-24', alt: 'Šermířka v černém a šermíř ve fialovém kabátě v dramatickém okamžiku souboje', cols: 3, rows: 1, w: 1400, h: 932 },
  { src: 'gallery-25', alt: 'Šermíř v akrobatickém pádu a soupeř s mečem v humorné scéně', cols: 3, rows: 1, w: 1400, h: 932 },
  { src: 'gallery-15', alt: 'Šermíř s rozpřaženýma rukama uprostřed hrané scény, za ním diváci', cols: 4, rows: 2, w: 1400, h: 646 },
  { src: 'gallery-22', alt: 'Šermíř ve fialovém kabátě v předklonu s mečem v ruce', cols: 2, rows: 1, w: 1400, h: 932 },
  { src: 'gallery-26', alt: 'Dva šermíři v tuhém zápase zblízka', cols: 2, rows: 1, w: 1400, h: 932 },
  { src: 'gallery-27', alt: 'Šermíř v šedé vestě a soupeřka s mečem v souboji', cols: 2, rows: 1, w: 1400, h: 932 },
  { src: 'gallery-28', alt: 'Dva šermíři se střetávají v souboji s meči', cols: 2, rows: 1, w: 1400, h: 932 },
  { src: 'gallery-29', alt: 'Šermíř ve fialovém kabátě a šermířka v bílé košili se střetávají meči', cols: 2, rows: 1, w: 1400, h: 932 },
];

const tileSizes = (cols: number) =>
  `(max-width: 560px) 100vw, (max-width: 1024px) ${cols > 2 ? 100 : 50}vw, ${Math.round((cols / 6) * 1100)}px`;
---

<section class="scena-gallery act-section section section--tint" id="galerie-vyber">
  <span class="act-node" aria-hidden="true"></span>
  <div class="container">
    <div class="section-head reveal">
      <p class="kicker">
        {act && <span class="kicker__act">{act}</span>}
        <span class="kicker__label">Galerie</span>
      </p>
      <h2 class="section-title" data-reveal={act ? 'curtain' : undefined}>{cs('Scény z představení')}</h2>
      <p class="section-subtitle">{cs('Výřezy z našich vystoupení a akcí. Kliknutím fotku zvětšíte.')}</p>
    </div>

    <div class="gallery__grid" data-reveal-group>
      {images.map((img) => (
        <button
          type="button"
          class:list={['gallery__item', `gallery__item--${img.area}`]}
          data-reveal
          data-lightbox
          data-full-src={asset(`/images/opt/${img.src}.jpg`)}
          aria-label={`Zvětšit fotografii: ${img.alt}`}
        >
          <Picture
            src={`/images/opt/${img.src}.jpg`}
            alt={img.alt}
            width={img.w}
            height={img.h}
            loading="lazy"
            sizes={
              img.area === 'g1'
                ? '(max-width: 560px) 100vw, (max-width: 1024px) 100vw, 560px'
                : '(max-width: 560px) 100vw, (max-width: 1024px) 50vw, 300px'
            }
          />
          <span class="gallery__zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
            </svg>
          </span>
        </button>
      ))}
    </div>

    {!extended && (
      <p class="gallery__all reveal">
        <a href={page('/galerie')} class="btn btn--ghost">Celá galerie <span class="btn__arrow" aria-hidden="true">→</span></a>
      </p>
    )}

    {extended && (
      <>
        <div class="gallery__more reveal">
          <p class="kicker"><span class="kicker__label">Další fotky</span></p>
          <h3 class="gallery__more-title">Ze sezóny 2026</h3>
        </div>
        <div class="gallery__grid gallery__grid--more" data-reveal-group>
          {extraImages.map((img) => (
            <button
              type="button"
              class="gallery__item"
              data-kind={img.cols >= 3 ? 'wide' : img.h > img.w ? 'tall' : 'std'}
              style={`--c: ${img.cols}; --r: ${img.rows};`}
              data-reveal
              data-lightbox
              data-full-src={asset(`/images/opt/${img.src}.jpg`)}
              aria-label={`Zvětšit fotografii: ${img.alt}`}
            >
              <Picture
                src={`/images/opt/${img.src}.jpg`}
                alt={img.alt}
                width={img.w}
                height={img.h}
                loading="lazy"
                sizes={tileSizes(img.cols)}
              />
              <span class="gallery__zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
            </svg>
          </span>
            </button>
          ))}
        </div>
      </>
    )}
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Zvětšená fotografie">
    <button type="button" class="lightbox__btn lightbox__close" id="lightboxClose" aria-label="Zavřít galerii">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__prev" id="lightboxPrev" aria-label="Předchozí fotografie">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <figure class="lightbox__stage">
      <img id="lightboxImg" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="" />
      <figcaption class="lightbox__meta">
        <span id="lightboxNum" class="lightbox__num" aria-hidden="true"></span>
        <span id="lightboxCounter" class="lightbox__counter" aria-live="polite"></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__next" id="lightboxNext" aria-label="Další fotografie">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </dialog>
</section>

<style>
  .scena-gallery { background: var(--bg); }

  /* --- Mozaikový grid (intencionální asymetrie, žádné díry) --- */
  .gallery__grid {
    display: grid;
    grid-template-areas:
      'g1 g1 g2 g3'
      'g1 g1 g2 g4'
      'g5 g6 g6 g4'
      'g5 g7 g7 g8';
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(150px, 15vw, 205px);
    gap: clamp(0.7rem, 1.6vw, 1.1rem);
  }

  .gallery__item {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 1px solid transparent;
    text-align: left;
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
    background: var(--bg-3);
    transition:
      transform var(--t-med) var(--ease-out),
      border-color var(--t-fast) var(--ease),
      box-shadow var(--t-med) var(--ease);
  }
  .gallery__item:focus-visible {
    transform: translateY(-4px);
    border-color: var(--stroke-strong);
    box-shadow: var(--shadow-1), var(--shadow-red);
  }
  @media (hover: hover) and (pointer: fine) {
    .gallery__item:hover {
      transform: translateY(-4px);
      border-color: var(--stroke-strong);
      box-shadow: var(--shadow-1), var(--shadow-red);
    }
  }

  /* Karmínový vlasový řádek shora */
  .gallery__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--crimson), rgba(178, 175, 63, 0.7));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
    z-index: 2;
  }
  @media (hover: hover) and (pointer: fine) {
    .gallery__item:hover::before { transform: scaleX(1); }
  }
  .gallery__item:focus-visible::before { transform: scaleX(1); }

  .gallery__item--g1 { grid-area: g1; }
  .gallery__item--g2 { grid-area: g2; }
  .gallery__item--g3 { grid-area: g3; }
  .gallery__item--g4 { grid-area: g4; }
  .gallery__item--g5 { grid-area: g5; }
  .gallery__item--g6 { grid-area: g6; }
  .gallery__item--g7 { grid-area: g7; }
  .gallery__item--g8 { grid-area: g8; }

  /* --- Nejnovější fotky (rozšířená galerie na /galerie) --- */
  .gallery__more { margin-top: clamp(2.4rem, 5vw, 3.6rem); }
  .gallery__more-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 500;
    margin-top: var(--sp-2);
    margin-bottom: var(--sp-5);
  }
  .gallery__grid--more {
    grid-template-areas: none;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: clamp(120px, 14.5vw, 188px);
  }
  .gallery__grid--more .gallery__item {
    grid-column: span var(--c);
    grid-row: span var(--r);
  }
  .gallery__grid--more .gallery__item :global(img) { object-position: center 32%; }

  .gallery__all { margin-top: var(--sp-6); display: flex; justify-content: flex-end; }

  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    display: block;
    filter: saturate(0.88) contrast(1.05);
    transition: transform var(--dur-4) var(--ease-out), filter var(--t-med) var(--ease);
  }
  .gallery__grid:not(.gallery__grid--more) .gallery__item:nth-child(7) :global(img) { object-position: center 18%; }
  .gallery__item:focus-visible :global(img) {
    transform: scale(1.045);
    filter: saturate(1.05) contrast(1.08);
  }
  @media (hover: hover) and (pointer: fine) {
    .gallery__item:hover :global(img) {
      transform: scale(1.045);
      filter: saturate(1.05) contrast(1.08);
    }
  }

  .gallery__zoom {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    border: 1px solid var(--line-2);
    background: rgba(6, 6, 6, 0.5);
    opacity: 0;
    transition: opacity var(--t-med) var(--ease), color var(--t-med) var(--ease);
  }
  .gallery__item:focus-visible .gallery__zoom { opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    .gallery__item:hover .gallery__zoom { opacity: 1; }
    .gallery__zoom:hover { color: var(--crimson-bright); }
  }

  /* --- Lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-lightbox);
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: lightbox-in var(--dur-2) var(--ease-out);
  }
  .lightbox::backdrop {
    background: rgba(10, 10, 10, 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  @keyframes lightbox-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .lightbox:not([open]) {
    display: none;
  }

  .lightbox__stage {
    margin: 0;
    max-width: min(92vw, 1200px);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .lightbox__stage img {
    max-width: 92vw;
    max-height: 76vh;
    object-fit: contain;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-2);
    background: var(--color-black);
  }
  .lightbox__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .lightbox__num {
    font-family: var(--font-ui);
    color: var(--crimson-bright);
    letter-spacing: 0.2em;
  }
  .lightbox__counter { color: var(--crimson-bright); letter-spacing: 0.3em; }

  .lightbox__btn {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    color: var(--ink);
    border: 1px solid var(--line-2);
    background: rgba(10, 10, 10, 0.6);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .lightbox__btn:hover,
  .lightbox__btn:focus-visible {
    color: var(--crimson-bright);
    border-color: var(--crimson);
    background: rgba(228, 6, 7, 0.08);
  }
  .lightbox__close { top: 1.4rem; right: 1.4rem; }
  .lightbox__prev { left: 1.4rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 1.4rem; top: 50%; transform: translateY(-50%); }

  @media (max-width: 1024px) {
    .gallery__grid {
      grid-template-areas:
        'g1 g1'
        'g2 g3'
        'g4 g5'
        'g6 g7'
        'g8 g8';
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: auto;
    }
    .gallery__item { aspect-ratio: 4 / 3; }
    .gallery__grid--more {
      grid-template-areas: none;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: clamp(70px, 17vw, 130px);
      grid-auto-flow: dense;
    }
    .gallery__grid--more .gallery__item { aspect-ratio: auto; grid-column: span 1; grid-row: span 2; }
    .gallery__grid--more .gallery__item[data-kind='wide'] { grid-column: span 2; grid-row: span 3; }
    .gallery__grid--more .gallery__item[data-kind='tall'] { grid-row: span 4; }
    .gallery__item :global(img) { position: absolute; inset: 0; }
    .lightbox__prev, .lightbox__next {
      top: auto;
      bottom: 1.2rem;
      transform: none;
      width: 48px;
      height: 48px;
    }
    .lightbox__prev { left: 1.2rem; }
    .lightbox__next { right: 1.2rem; }
    .lightbox__stage img { max-height: 70vh; }
  }
  @media (max-width: 560px) {
    .gallery__grid {
      grid-template-areas:
        'g1'
        'g2'
        'g3'
        'g4'
        'g5'
        'g6'
        'g7'
        'g8';
      grid-template-columns: 1fr;
    }
    .gallery__grid--more { grid-template-areas: none; grid-template-columns: 1fr; grid-auto-rows: auto; }
    .gallery__grid--more .gallery__item,
    .gallery__grid--more .gallery__item[data-kind] { grid-column: auto; grid-row: auto; aspect-ratio: 3 / 2; }
    .gallery__grid--more .gallery__item[data-kind='tall'] { aspect-ratio: 3 / 4; }
  }
</style>
