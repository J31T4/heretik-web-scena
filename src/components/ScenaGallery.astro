---
import { asset } from '../utils/paths.js';

const images = [
  asset('/images/gallery-1.jpeg'),
  asset('/images/gallery-2.jpeg'),
  asset('/images/gallery-3.jpeg'),
  asset('/images/gallery-4.jpeg'),
  asset('/images/gallery-5.jpeg'),
  asset('/images/gallery-6.jpeg'),
  asset('/images/gallery-7.jpeg'),
  asset('/images/gallery-8.jpeg'),
];
---

<section class="scena-gallery section">
  <div class="container">
    <p class="section-label reveal">Dějství III</p>
    <h2 class="section-title reveal">Scény z představení</h2>
    <div class="divider reveal"><span></span></div>

    <div class="gallery__grid">
      {images.map((src, i) => (
        <figure class="gallery__item reveal">
          <img src={src} alt={`Scéna ${i + 1}`} loading="lazy" />
          <figcaption>
            <span>Scéna {String(i + 1).padStart(2, '0')}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }

  .gallery__item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    margin: 0;
    cursor: pointer;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease), filter 0.6s var(--ease);
    filter: saturate(0.85) contrast(1.05);
  }

  .gallery__item:hover img {
    transform: scale(1.12);
    filter: saturate(1.15) contrast(1.1);
  }

  .gallery__item figcaption {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.2rem;
    background: linear-gradient(180deg, transparent 55%, rgba(10, 10, 10, 0.85));
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .gallery__item:hover figcaption { opacity: 1; }

  .gallery__item figcaption span {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
  }

  @media (max-width: 1024px) {
    .gallery__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .gallery__grid { grid-template-columns: 1fr; }
  }
</style>
