---
import { asset, page } from '../utils/paths.js';

const services = [
  {
    title: 'Historický šerm',
    description: `Autentické vystoupení inspirované dochovanými učebnicemi starých šermířských mistrů. Oživujeme techniky a příběhy minulosti.`,
    icon: '⚔️',
  },
  {
    title: 'Scénická vystoupení',
    description: `Propojení šermu s divadelním uměním. Commedia dell'arte, fantastické příběhy a vlastní choreografie pro nezapomenutelný zážitek.`,
    icon: '🎭',
  },
  {
    title: 'Choreografie na míru',
    description: `Připravíme vystoupení pro městské slavnosti, historické dny, plesy, firemní večírky, oslavy, tábory i školní programy.`,
    icon: '✨',
  },
];
---

<section class="services section">
  <div class="container">
    <div class="section-title">
      <h2>CO DĚLÁME</h2>
      <p>Oživujeme historii skrze šerm, divadlo a příběhy</p>
    </div>
    
    <div class="services__grid">
      {services.map(service => (
        <div class="services__card">
          <div class="services__icon">{service.icon}</div>
          <h3 class="services__title">{service.title}</h3>
          <p class="services__description">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-surface);
  }
  
  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .services__card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    transition: all var(--transition);
  }
  
  .services__card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  
  .services__icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }
  
  .services__title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }
  
  .services__description {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0;
  }
  
  @media (max-width: 768px) {
    .services__grid {
      gap: 1.5rem;
    }
    
    .services__card {
      padding: 2rem;
    }
  }
</style>
