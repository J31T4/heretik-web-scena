---
interface Props {
  backgroundImage?: string;
}

const { backgroundImage = '/images/hero-1.jpeg' } = Astro.props;
---

<section class="hero">
  <div class="hero__background">
    <img src={backgroundImage} alt="Historický šerm" />
    <div class="hero__overlay"></div>
  </div>
  
  <div class="container hero__content">
    <h1 class="hero__title">ŠERMÍŘI S VÁŠNÍ A UMĚNÍM</h1>
    <p class="hero__subtitle">
      Historický a scénický šerm z Mohelnice. Oživujeme dávné bojové umění 
      a přenášíme ho do současnosti.
    </p>
    <div class="hero__cta">
      <a href="/kontakt" class="btn btn--primary btn--large">
        Domluvit vystoupení
      </a>
      <a href="/galerie" class="btn btn--ghost btn--large">
        Prohlédnout galerii
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  
  .hero__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4) contrast(1.1);
  }
  
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.6) 0%,
      rgba(10, 10, 10, 0.8) 50%,
      rgba(10, 10, 10, 1) 100%
    );
  }
  
  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 6rem 1.5rem;
  }
  
  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    line-height: 1;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }
  
  .hero__subtitle {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }
  
  .hero__cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  @media (max-width: 768px) {
    .hero__content {
      padding: 4rem 1rem;
    }
    
    .hero__cta {
      flex-direction: column;
      align-items: center;
    }
    
    .hero__cta .btn {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
