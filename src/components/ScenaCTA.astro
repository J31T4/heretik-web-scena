---
import { asset, page } from '../utils/paths.js';
---

<section class="scena-cta">
  <div class="cta__bg" aria-hidden="true">
    <picture>
      <source media="(max-width: 760px)" srcset={asset('/images/opt/hero-2-900.webp')} type="image/webp" />
      <source media="(max-width: 760px)" srcset={asset('/images/opt/hero-2-900.jpg')} type="image/jpeg" />
      <source srcset={asset('/images/opt/hero-2.webp')} type="image/webp" />
      <img src={asset('/images/opt/hero-2.jpg')} alt="" loading="lazy" decoding="async" width="1500" height="999" />
    </picture>
    <div class="cta__veil"></div>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <div class="container cta__inner">
    <p class="act-label reveal" style="justify-content:center">Finále · Rezervace</p>
    <h2 class="cta__title reveal">
      Rezervujte si<br />
      <span class="fire-text">své představení</span>
    </h2>
    <p class="cta__subtitle reveal">
      Městská slavnost, ples, firemní večírek nebo školní den –
      připravíme vystoupení přesně pro vaši akci.
    </p>
    <p class="cta__scope reveal" aria-label="Typy akcí">
      <span>Městské slavnosti</span><i aria-hidden="true">·</i>
      <span>školy</span><i aria-hidden="true">·</i>
      <span>plesy</span><i aria-hidden="true">·</i>
      <span>firemní akce</span>
    </p>
    <div class="cta__action reveal">
      <a href={page('/kontakt')} class="btn btn--primary btn--large">
        Poptat vystoupení <span class="btn__arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .scena-cta {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid var(--line);
    padding: var(--sp-9) 0;
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cta__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    filter: saturate(0.88) contrast(1.08) brightness(0.82);
  }
  .cta__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 6, 6, 0.62) 0%, rgba(6, 6, 6, 0.25) 38%, rgba(6, 6, 6, 0.72) 100%),
      radial-gradient(ellipse 70% 90% at 50% 100%, rgba(228, 6, 7, 0.2), transparent 65%);
  }

  .cta__inner {
    position: relative;
    z-index: 3;
    max-width: 780px;
  }

  .cta__title {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    margin-bottom: var(--sp-5);
  }

  .cta__subtitle {
    font-size: var(--fs-lead);
    color: rgba(242, 237, 228, 0.85);
    max-width: 560px;
    margin: 0 auto var(--sp-6);
  }

  .cta__scope {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: var(--sp-7);
  }
  .cta__scope i { color: var(--crimson); font-style: normal; }

  .cta__action .btn { min-width: 240px; }
</style>
