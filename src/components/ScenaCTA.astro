---
import BookingButton from './BookingButton.astro';
import Picture from './Picture.astro';
import Blade from './Blade.astro';
import { cs } from '../utils/typo.js';
import { contactEmail } from '../data/site.js';
---

<section class="scena-cta">
  <div class="cta__bg" aria-hidden="true">
    <Picture
      src="/images/opt/hero-2.jpg"
      alt=""
      width={1600}
      height={739}
      loading="lazy"
      sizes="100vw"
      mobileSrc="/images/opt/hero-2-900.jpg"
    />
    <div class="cta__veil"></div>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <div class="container cta__inner">
    <p class="kicker kicker--center reveal"><span class="kicker__act">Finále</span><span class="kicker__label">Rezervace</span></p>
    <h2 class="cta__title reveal">
      Rezervujte si<br />
      <span class="fire-text">své představení</span>
    </h2>
    <p class="cta__subtitle reveal">{cs('Městská slavnost, ples, firemní večírek nebo školní den – připravíme vystoupení přesně pro vaši akci.')}</p>
    <p class="cta__scope reveal">
      <span>Městské slavnosti</span><i aria-hidden="true">·</i>
      <span>školy</span><i aria-hidden="true">·</i>
      <span>plesy</span><i aria-hidden="true">·</i>
      <span>firemní akce</span>
    </p>
    <div class="cta__action reveal">
      <BookingButton size="large" />
    </div>
    <Blade center class="cta__blade" />
    <p class="cta__mail reveal">
      Nebo napište přímo na <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
  </div>
</section>

<style>
  .scena-cta {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid var(--line);
    padding: var(--sp-9) 0;
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cta__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    filter: saturate(0.88) contrast(1.08) brightness(0.82);
  }
  .cta__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 6, 6, 0.62) 0%, rgba(6, 6, 6, 0.25) 38%, rgba(6, 6, 6, 0.72) 100%),
      radial-gradient(ellipse 70% 90% at 50% 100%, rgba(228, 6, 7, 0.2), transparent 65%);
  }

  .cta__inner {
    position: relative;
    z-index: 3;
    max-width: 780px;
  }

  .cta__title {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    margin-bottom: var(--sp-5);
  }

  .cta__subtitle {
    font-size: var(--fs-lead);
    color: rgba(242, 237, 228, 0.85);
    max-width: 560px;
    margin: 0 auto var(--sp-6);
  }

  .cta__scope {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: var(--sp-7);
  }
  .cta__scope i { color: var(--crimson); font-style: normal; }

  .cta__action :global(.btn) { min-width: 240px; }
  .cta__inner :global(.cta__blade) { margin-top: var(--sp-7); margin-bottom: var(--sp-4); }
  .cta__mail { font-size: 0.95rem; color: var(--ink-2); }
  .cta__mail a {
    color: var(--ink);
    border-bottom: 1px solid var(--crimson);
    padding-block: 0.3rem;
    word-break: break-word;
    transition: color var(--t-fast) var(--ease);
  }
  .cta__mail a:hover,
  .cta__mail a:focus-visible { color: var(--crimson-bright); }
</style>
