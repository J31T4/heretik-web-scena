---
// SHŠ Heretik — Scéna · Picture.astro
// <picture> s responzivními variantami (480/800/1200/plná) WebP + JPG,
// base-prefixed cesty, povinné rozměry (CLS=0), loading/decoding/fetchpriority.
import { asset } from '../utils/paths.js';

interface Props {
  /** JPG cesta z public/images/opt (např. '/images/opt/gallery-1.jpg') — plná varianta */
  src: string;
  alt: string;
  width: number;
  height: number;
  /** sizes atribut pro srcset (např. '(max-width: 560px) 100vw, 50vw') */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Třída na <picture> */
  class?: string;
  /** Třída na <img> */
  imgClass?: string;
  /** Volitelná responzivní varianta (např. hero-1-900.jpg) + její media dotaz */
  mobileSrc?: string;
  mobileMedia?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  class: className,
  imgClass,
  mobileSrc,
  mobileMedia = '(max-width: 760px)',
} = Astro.props;

const toWebp = (path) => path.replace(/\.jpe?g$/i, '.webp');
const withoutExt = (path) => path.replace(/\.jpe?g$/i, '');

// srcset z dostupných variant: 480/800/1200 (jen pokud < šířky obrázku) + plná
const baseNoExt = withoutExt(src);
const variantWidths = [480, 800, 1200].filter((v) => v < width);
const srcsetCandidates = variantWidths.map((v) => `${asset(`${baseNoExt}-${v}.webp`)} ${v}w`);
srcsetCandidates.push(`${asset(toWebp(src))} ${width}w`);
const webpSrcset = srcsetCandidates.join(', ');
const jpgSrcset = srcsetCandidates.map((c) => c.replace(/\.webp/g, '.jpg')).join(', ');

const imgProps: Record<string, string | number | undefined> = {
  src: asset(src),
  alt,
  width,
  height,
  loading,
  decoding,
  fetchpriority,
  class: imgClass,
  sizes,
};
for (const key of ['loading', 'decoding', 'fetchpriority', 'class', 'sizes']) {
  if (imgProps[key] === undefined || imgProps[key] === 'auto') delete imgProps[key];
}
---

{
  mobileSrc ? (
    <picture class:list={className}>
      <source media={mobileMedia} srcset={asset(toWebp(mobileSrc))} type="image/webp" />
      <source media={mobileMedia} srcset={asset(mobileSrc)} type="image/jpeg" />
      <source srcset={webpSrcset} type="image/webp" sizes={sizes} />
      <source srcset={jpgSrcset} type="image/jpeg" sizes={sizes} />
      <img {...imgProps} />
    </picture>
  ) : (
    <picture class:list={className}>
      <source srcset={webpSrcset} type="image/webp" sizes={sizes} />
      <source srcset={jpgSrcset} type="image/jpeg" sizes={sizes} />
      <img {...imgProps} />
    </picture>
  )
}
