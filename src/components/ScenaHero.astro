---
import { asset, page } from '../utils/paths.js';
---

<section class="scena-hero">
  <div class="hero__bg">
    <img src={asset('/images/hero-1.jpeg')} alt="" />
    <div class="hero__overlay"></div>
  </div>

  <canvas class="hero__sparks" id="sparksCanvas" aria-hidden="true"></canvas>

  <div class="container hero__content">
    <p class="hero__eyebrow reveal">Historický a scénický šerm · Mohelnice</p>
    <h1 class="hero__title reveal">
      PŘEDSTAVENÍ<br />
      <span class="fire-text">ZAČÍNÁ</span>
    </h1>
    <p class="hero__subtitle reveal">
      Oživujeme dávné bojové umění a přenášíme ho do současnosti.
      Scénický šerm, historické techniky, vlastní choreografie.
    </p>
    <div class="hero__cta reveal">
      <a href={page('/kontakt')} class="btn btn--primary">Poptat vystoupení</a>
      <a href={page('/galerie')} class="btn btn--ghost">Prohlédnout galerii</a>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span>SCROLL</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<script>
  // Jiskry ohně – canvas particle efekt s glow a delší životností
  (function () {
    const canvas = document.getElementById('sparksCanvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    let width, height, particles = [];
    const MAX_PARTICLES = 130;

    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      width = canvas.width = rect.width;
      height = canvas.height = rect.height;
    }

    function spawn() {
      const big = Math.random() < 0.18; // občasná velká jiskra
      return {
        x: Math.random() * width,
        y: height + Math.random() * 60,
        size: big ? Math.random() * 4 + 3 : Math.random() * 2.2 + 0.8,
        speed: Math.random() * 1.4 + 0.5,
        drift: (Math.random() - 0.5) * 0.8,
        life: 1,
        decay: big
          ? Math.random() * 0.0008 + 0.0004  // velké jiskry žijí ~20-40s
          : Math.random() * 0.002 + 0.001,   // malé ~7-15s
        hue: Math.random() > 0.35 ? 0 : 45,  // červená nebo zlatá
        flicker: Math.random() * 0.15,
      };
    }

    function tick() {
      ctx.clearRect(0, 0, width, height);

      if (particles.length < MAX_PARTICLES && Math.random() < 0.6) {
        particles.push(spawn());
      }

      particles = particles.filter(p => p.life > 0);

      for (const p of particles) {
        p.y -= p.speed;
        p.x += p.drift + Math.sin(p.y * 0.02 + p.flicker) * 0.6;
        p.life -= p.decay;

        const isRed = p.hue === 0;
        const color = isRed ? '228, 6, 7' : '178, 175, 63';

        // Jiskra drží plnou velikost a jas po většinu života,
        // dohasíná (fade) až na konci – žádné náhlé zmizení
        const fade = Math.min(p.life * 1.8, 1);

        // Glow efekt
        ctx.shadowBlur = p.size * 6;
        ctx.shadowColor = `rgba(${color}, ${fade})`;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${color}, ${fade})`;
        ctx.fill();

        // Jasné jádro
        ctx.shadowBlur = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * 0.4, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 240, 210, ${fade * 0.9})`;
        ctx.fill();
      }

      requestAnimationFrame(tick);
    }

    resize();
    window.addEventListener('resize', resize);
    tick();
  })();
</script>

<style>
  .scena-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.55) 55%, rgba(10,10,10,0.3) 100%),
      linear-gradient(180deg, rgba(10,10,10,0.3) 0%, transparent 40%, rgba(10,10,10,0.85) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: 4rem;
    padding-bottom: 6rem;
    max-width: 720px;
  }

  .hero__eyebrow {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    color: rgba(245, 240, 235, 0.85);
    max-width: 520px;
    margin-bottom: 2.5rem;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__scroll {
    position: absolute;
    right: 2.5rem;
    bottom: 3rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .hero__sparks {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero__scroll span {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.35em;
    color: var(--text-secondary);
    writing-mode: vertical-rl;
  }

  .hero__scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(180deg, var(--red), transparent);
    animation: scrollPulse 2s var(--ease) infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @media (max-width: 768px) {
    .hero__scroll { display: none; }
    .hero__content { padding-bottom: 4rem; }
  }
</style>
