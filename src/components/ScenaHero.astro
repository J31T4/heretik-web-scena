---
import BookingButton from './BookingButton.astro';
import Picture from './Picture.astro';
import { page } from '../utils/paths.js';
import { cs } from '../utils/typo.js';
---

<section class="scena-hero">
  <div class="hero__bg" data-hero-parallax aria-hidden="true">
    <Picture
      src="/images/opt/hero-1.jpg"
      alt=""
      imgClass="hero__drift"
      width={1568}
      height={1024}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      mobileSrc="/images/opt/hero-1-900.jpg"
    />
  </div>

  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__curtain hero__curtain--l" aria-hidden="true"></div>
  <div class="hero__curtain hero__curtain--r" aria-hidden="true"></div>
  <div class="hero__spotlight" aria-hidden="true"></div>
  <div class="hero__beam" aria-hidden="true"></div>
  <div class="grain grain--animated" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="hero__eyebrow">
      <span class="hero__eyebrow-dash" aria-hidden="true"></span>
      {cs('Historický a scénický šerm · Mohelnice')}
    </p>

    <div class="hero__glint" aria-hidden="true"><i></i></div>

    <h1 class="hero__title">
      <span class="hero__title-kicker">Představení</span>
      <span class="hero__title-main fire-text">ZAČÍNÁ</span>
    </h1>

    <p class="hero__subtitle">{cs('Oživujeme dávné bojové umění a přenášíme ho do současnosti. Scénický šerm, historické techniky, vlastní choreografie.')}</p>

    <div class="hero__cta">
      <BookingButton />
      <a href={page('/galerie')} class="btn btn--ghost">Prohlédnout galerii</a>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span>DOLŮ</span>
    <div class="hero__scroll-line"></div>
  </div>

  <div class="hero__frame" aria-hidden="true"></div>
</section>

<style>
  .scena-hero {
    position: relative;
    min-height: 92vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* --- Pozadí s driftem (parallax na rodiči) --- */
  .hero__bg {
    position: absolute;
    inset: -6% 0;
    z-index: 0;
    will-change: transform;
  }
  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  html.enhanced :global(.hero__drift) {
    animation: hero-drift 26s ease-in-out infinite alternate;
  }
  @keyframes hero-drift {
    from { transform: scale(1.05) translateY(-1%); }
    to { transform: scale(1.12) translateY(1%); }
  }

  /* --- Záběr / opona / světla (statické vrstvy nad parallaxem) --- */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(6, 6, 6, 0.92) 0%, rgba(6, 6, 6, 0.55) 40%, rgba(6, 6, 6, 0.15) 68%, rgba(6, 6, 6, 0.55) 100%),
      linear-gradient(180deg, rgba(6, 6, 6, 0.66) 0%, rgba(6, 6, 6, 0.04) 24%, rgba(6, 6, 6, 0.22) 60%, rgba(6, 6, 6, 0.97) 100%);
  }

  .hero__curtain {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(80px, 12vw, 200px);
    z-index: 1;
    pointer-events: none;
  }
  .hero__curtain--l {
    left: 0;
    background: linear-gradient(90deg, rgba(3, 3, 3, 0.92) 0%, rgba(3, 3, 3, 0.35) 55%, transparent 100%);
  }
  .hero__curtain--l::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(228, 6, 7, 0.45) 30%, rgba(228, 6, 7, 0.45) 70%, transparent);
  }
  .hero__curtain--r {
    right: 0;
    background: linear-gradient(270deg, rgba(3, 3, 3, 0.92) 0%, rgba(3, 3, 3, 0.35) 55%, transparent 100%);
  }

  /* Kužel reflektoru — jemná šikmá světelná stopa */
  .hero__spotlight {
    position: absolute;
    top: -18%;
    left: 12%;
    width: 46%;
    height: 130%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      118deg,
      transparent 34%,
      rgba(242, 237, 228, 0.055) 45%,
      rgba(242, 237, 228, 0.1) 50%,
      rgba(242, 237, 228, 0.055) 55%,
      transparent 66%
    );
    mix-blend-mode: screen;
    transform: rotate(-8deg);
  }
  html.enhanced .hero__spotlight {
    animation: spotlight-sway 16s ease-in-out infinite alternate;
  }
  @keyframes spotlight-sway {
    from { transform: rotate(-8deg) translateX(-1.5%); }
    to { transform: rotate(-3deg) translateX(2%); }
  }

  /* Druhý, širší a slabší pás světla z pravého horního rohu */
  .hero__beam {
    position: absolute;
    top: -30%;
    right: -8%;
    width: 55%;
    height: 150%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(228, 6, 7, 0.06) 0%, transparent 45%, transparent 60%, rgba(242, 237, 228, 0.04) 100%);
  }

  /* --- Obsah --- */
  .hero__content {
    position: relative;
    z-index: 5;
    width: 100%;
    padding-top: calc(var(--sp-8) + 1rem);
    padding-bottom: var(--sp-8);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--sp-5);
  }
  .hero__eyebrow-dash {
    width: 34px;
    height: 1px;
    background: currentColor;
    opacity: 0.75;
  }

  /* Glint — záblesk na čepeli pod eyebrow */
  .hero__glint {
    position: relative;
    width: 190px;
    height: 1px;
    background: var(--line-2);
    margin-bottom: var(--sp-5);
    overflow: hidden;
  }
  .hero__glint i {
    position: absolute;
    top: -1px;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, transparent, rgba(242, 237, 228, 0.95), transparent);
    transform: translateX(-100%);
  }
  html.enhanced .hero__glint i { animation: glint-sweep 6s var(--ease) infinite; }
  @keyframes glint-sweep {
    0% { transform: translateX(-100%); opacity: 0; }
    12% { opacity: 1; }
    26% { transform: translateX(330%); opacity: 0; }
    100% { transform: translateX(330%); opacity: 0; }
  }

  .hero__title {
    margin-bottom: var(--sp-5);
    font-weight: 500;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.5), 0 1px 3px rgba(0, 0, 0, 0.4);
  }
  .hero__title-kicker {
    display: block;
    font-size: clamp(1.55rem, 4.4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 0.28em;
  }
  .hero__title-main {
    display: block;
    font-size: clamp(3.6rem, 10.5vw, 8.4rem);
    font-weight: 600;
    line-height: 0.95;
  }

  .hero__subtitle {
    font-size: var(--fs-lead);
    color: rgba(242, 237, 228, 0.88);
    max-width: 520px;
    margin-bottom: var(--sp-6);
  }

  .hero__cta {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .hero__cta :global(.btn--ghost) {
    border-color: rgba(242, 237, 228, 0.4);
    background: rgba(6, 6, 6, 0.35);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .hero__cta :global(.btn--ghost:hover) {
    border-color: var(--crimson-bright);
    background: rgba(6, 6, 6, 0.55);
  }

  /* --- Scroll cue --- */
  .hero__scroll {
    position: absolute;
    left: calc(var(--gutter) + 6px);
    bottom: calc(var(--sp-6) + env(safe-area-inset-bottom));
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }
  .hero__scroll span {
    font-family: var(--font-ui);
    font-size: 0.64rem;
    letter-spacing: 0.4em;
    color: var(--ink-3);
    writing-mode: vertical-rl;
  }
  .hero__scroll-line {
    width: 1px;
    height: 64px;
    background: linear-gradient(180deg, var(--steel), transparent);
    transform-origin: top;
    animation: scroll-pulse 2.2s var(--ease-in-out) infinite;
  }
  @keyframes scroll-pulse {
    0% { transform: scaleY(0.2); opacity: 1; }
    60% { transform: scaleY(1); opacity: 0.25; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* --- Rám scény --- */
  .hero__frame {
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(242, 237, 228, 0.07);
    z-index: 3;
    pointer-events: none;
  }

  /* --- Vstupní sekvence (až po enhanced) --- */
  html.enhanced .hero__content > * {
    opacity: 0;
    animation: hero-in 1s var(--ease-out) forwards;
  }
  html.enhanced .hero__eyebrow { animation-delay: 0.15s; }
  html.enhanced .hero__glint { animation-delay: 0.3s; }
  html.enhanced .hero__title { animation-delay: 0.38s; }
  html.enhanced .hero__subtitle { animation-delay: 0.6s; }
  html.enhanced .hero__cta { animation-delay: 0.75s; }
  html.enhanced .hero__scroll { animation: hero-in 1.1s var(--ease-out) 1.1s both; }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hero__curtain--r, .hero__beam, .hero__frame { display: none; }
    .hero__scroll { display: none; }
    .hero__content { padding-top: var(--sp-8); }
  }
  @media (max-width: 560px) {
    .hero__spotlight { display: none; }
    .hero__title-main { font-size: clamp(3.2rem, 15vw, 4.6rem); }
    .hero__content { padding-bottom: var(--sp-7); }
    .hero__cta { flex-direction: column; align-items: flex-start; }
    .hero__cta :global(.btn) { width: 100%; max-width: 320px; }
  }
</style>
