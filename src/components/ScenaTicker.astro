---
// Běžící pás s tím, co skupina dělá (texty z popisu webu).
// Druhá skupina je jen vizuální duplikát pro plynulou smyčku (aria-hidden).
import { cs } from '../utils/typo.js';

const items = [
  'Historický šerm',
  'Scénická vystoupení',
  'Vlastní choreografie',
  `Commedia dell'arte`,
  'Dobové techniky',
  'Vystoupení na míru',
  'Program pro školy',
];
---

<div class="ticker" role="group" aria-label="Co děláme">
  <div class="ticker__track">
    <ul class="ticker__group">
      {items.map((item) => <li class="ticker__item">{cs(item)}</li>)}
    </ul>
    <ul class="ticker__group" aria-hidden="true">
      {items.map((item) => <li class="ticker__item">{cs(item)}</li>)}
    </ul>
  </div>
</div>
