---
import { asset } from '../utils/paths.js';

const shows = [
  {
    title: 'Historický šerm',
    tag: 'autentika',
    description: 'Autentické vystoupení, při kterém v nácviku využíváme dochované učebnice starých šermířských mistrů.',
    image: asset('/images/opt/gallery-1.webp'),
    fallback: asset('/images/opt/gallery-1.jpg'),
    alt: 'Historický šerm – tábořiště s kostýmovanými šermíři',
    featured: true,
  },
  {
    title: 'Scénická vystoupení',
    tag: 'divadlo',
    description: `Vlastní choreografie, vtipné texty a scénky od commedie dell'arte až po fantastické povídky.`,
    image: asset('/images/opt/gallery-3.webp'),
    fallback: asset('/images/opt/gallery-3.jpg'),
    alt: 'Scénická vystoupení – souboj dvou šermířů před stany',
    featured: false,
  },
  {
    title: 'Vystoupení na míru',
    tag: 'na zakázku',
    description: 'Připravíme vystoupení pro městské slavnosti, historické dny, plesy, firemní večírky, oslavy narozenin i dětské tábory.',
    image: asset('/images/opt/gallery-5.webp'),
    fallback: asset('/images/opt/gallery-5.jpg'),
    alt: 'Vystoupení na míru – zákulisí šermířského ležení',
    featured: false,
  },
  {
    title: 'Program pro školy',
    tag: 'ZŠ',
    description: 'Program pro základní školy, který děti nejen pobaví, ale také přiučí novým věcem o historii.',
    image: asset('/images/opt/gallery-6.webp'),
    fallback: asset('/images/opt/gallery-6.jpg'),
    alt: 'Program pro školy – šermíři u hradní zdi',
    featured: false,
  },
];
---

<section class="scena-shows act-section section" id="program">
  <span class="act-node" aria-hidden="true"></span>
  <div class="container">
    <p class="act-label reveal">I. dějství</p>
    <div class="section-head reveal">
      <p class="section-label">Co děláme</p>
      <h2 class="section-title">Co hrajeme</h2>
    </div>

    <div class="program">
      {shows.map((show, i) => (
        <article class:list={['program__row', 'reveal', { 'program__row--featured': show.featured, 'program__row--flip': i % 2 === 1 }]}>
          <div class="program__index" aria-hidden="true">
            <span>{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="program__body">
            <span class="program__tag">{show.tag}</span>
            <h3 class="program__title">{show.title}</h3>
            <p class="program__desc">{show.description}</p>
          </div>
          <figure class="program__media">
            <picture>
              <source srcset={show.image} type="image/webp" />
              <img
                src={show.fallback}
                alt={show.alt}
                loading="lazy"
                decoding="async"
                width="1400"
                height={show.featured ? '666' : '934'}
              />
            </picture>
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .scena-shows { background: var(--bg-0); }

  .program { display: flex; flex-direction: column; }

  .program__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(90px, 150px) 1fr minmax(300px, 420px);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: var(--sp-7) 0;
    border-top: 1px solid var(--line);
  }
  .program__row:last-child { border-bottom: 1px solid var(--line); }

  .program__row--featured {
    grid-template-columns: minmax(90px, 150px) 1fr minmax(440px, 560px);
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .program__row--flip .program__media { order: -1; }
  @media (min-width: 1025px) {
    .program__row--flip {
      grid-template-columns: minmax(300px, 420px) 1fr minmax(90px, 150px);
      gap: clamp(1.5rem, 4vw, 3.5rem);
    }
    .program__row--flip .program__media { grid-column: 1; grid-row: 1; order: 0; }
    .program__row--flip .program__index { grid-column: 3; grid-row: 1; justify-self: end; }
  }

  /* Číslo — konturované, „ocelové“ */
  .program__index span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 6.5vw, 5.2rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.34);
    transition: -webkit-text-stroke-color var(--t-med) var(--ease), color var(--t-med) var(--ease);
  }
  @supports not (-webkit-text-stroke: 1px #000) {
    .program__index span { color: var(--ink-3); }
  }
  .program__row:hover .program__index span,
  .program__row:focus-within .program__index span {
    color: var(--crimson);
    -webkit-text-stroke-color: rgba(255, 74, 75, 0.9);
  }

  .program__body { max-width: 520px; }

  .program__tag {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid rgba(178, 175, 63, 0.35);
    padding: 0.32rem 0.7rem;
    margin-bottom: var(--sp-4);
  }

  .program__title {
    position: relative;
    display: inline-block;
    margin-bottom: var(--sp-4);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    padding-bottom: 0.35rem;
  }
  .program__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-med) var(--ease-out);
  }
  .program__row:hover .program__title::after,
  .program__row:focus-within .program__title::after { transform: scaleX(1); }

  .program__desc { font-size: 0.98rem; }

  .program__media {
    margin: 0;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-2);
  }
  .program__media::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(242, 237, 228, 0.14);
    pointer-events: none;
    transition: inset var(--t-med) var(--ease);
  }
  .program__row:hover .program__media::after,
  .program__row:focus-within .program__media::after { inset: 4px; }

  .program__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    aspect-ratio: 4 / 3;
    filter: saturate(0.9) contrast(1.04);
    transition: transform 0.7s var(--ease-out), filter var(--t-med) var(--ease);
  }
  .program__row:hover .program__media img,
  .program__row:focus-within .program__media img {
    transform: scale(1.06);
    filter: saturate(1.08) contrast(1.08);
  }

  .program__row--featured .program__media img { aspect-ratio: 21 / 10; object-position: center 40%; }
  .program__row--featured .program__index span { font-size: clamp(4rem, 8vw, 6.4rem); }

  @media (max-width: 1024px) {
    .program__row {
      grid-template-columns: 84px 1fr;
      gap: var(--sp-5);
      padding: var(--sp-6) 0;
    }
    .program__media { grid-column: 1 / -1; order: 3 !important; }
    .program__row--flip .program__media { order: 3 !important; }
    .program__row--flip .program__index { order: 1; }
    .program__media img { aspect-ratio: 16 / 9; }
    .program__row--featured .program__media img { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 560px) {
    .program__row { grid-template-columns: 56px 1fr; gap: var(--sp-4); }
    .program__index span { font-size: 2.6rem; }
    .program__row--featured .program__index span { font-size: 3.2rem; }
  }
</style>
