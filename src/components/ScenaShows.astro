---
import Picture from './Picture.astro';
import Blade from './Blade.astro';
import { cs } from '../utils/typo.js';
import { page } from '../utils/paths.js';

// Karty programu — bento kompozice: dvě široké a dvě užší karty, fotka plní celou plochu.
const shows = [
  {
    title: 'Historický šerm',
    tag: 'autentika',
    description: 'Autentické vystoupení, při kterém v nácviku využíváme dochované učebnice starých šermířských mistrů.',
    image: '/images/opt/gallery-1.jpg',
    alt: 'Historický šerm – tábořiště s kostýmovanými šermíři',
    span: 'wide',
    w: 1400,
    h: 666,
  },
  {
    title: 'Scénická vystoupení',
    tag: 'divadlo',
    description: `Vlastní choreografie, vtipné texty a scénky od commedie dell'arte až po fantastické povídky.`,
    image: '/images/opt/gallery-24.jpg',
    alt: 'Scénická vystoupení – herecký okamžik ze souboje',
    span: 'narrow',
    w: 1400,
    h: 932,
  },
  {
    title: 'Vystoupení na míru',
    tag: 'na zakázku',
    description: 'Připravíme vystoupení pro městské slavnosti, historické dny, plesy, firemní večírky, oslavy narozenin i dětské tábory.',
    image: '/images/opt/gallery-5.jpg',
    alt: 'Vystoupení na míru – zákulisí šermířského ležení',
    span: 'narrow',
    w: 1050,
    h: 1400,
  },
  {
    title: 'Program pro školy',
    tag: 'ZŠ',
    description: 'Program pro základní školy, který děti nejen pobaví, ale také přiučí novým věcem o historii.',
    image: '/images/opt/gallery-25.jpg',
    alt: 'Program pro školy – vtipná scéna z vystoupení',
    span: 'wide',
    w: 1400,
    h: 932,
  },
];
---

<section class="scena-shows act-section section" id="program">
  <span class="act-node" aria-hidden="true"></span>
  <div class="container">
    <div class="section-head reveal">
      <p class="kicker"><span class="kicker__act">I. dějství</span><span class="kicker__label">Co děláme</span></p>
      <h2 class="section-title" data-reveal="curtain">{cs('Co hrajeme')}</h2>
      <Blade />
    </div>

    <div class="program" data-reveal-group>
      {shows.map((show, i) => (
        <article class:list={['show', 'spot', `show--${show.span}`]} data-reveal>
          <figure class="show__media">
            <Picture
              src={show.image}
              alt={show.alt}
              width={show.w}
              height={show.h}
              loading="lazy"
              sizes={show.span === 'wide' ? '(max-width: 760px) 100vw, 700px' : '(max-width: 760px) 100vw, 520px'}
              imgClass="show__img"
            />
          </figure>
          <span class="show__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="show__body">
            <span class="show__tag">{show.tag}</span>
            <h3 class="show__title">{cs(show.title)}</h3>
            <p class="show__desc">{cs(show.description)}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="program__more reveal">
      <a href={page('/akce')} class="btn btn--ghost">Co všechno nabízíme <span class="btn__arrow" aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .scena-shows { background: var(--bg-0); }

  .program {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(400px, 36vw, 500px);
    gap: clamp(0.8rem, 1.6vw, 1.25rem);
  }
  .show--wide { grid-column: span 7; }
  .show--narrow { grid-column: span 5; }

  .show {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--bg-3);
    border: 1px solid var(--line-2);
    transition: border-color var(--t-med) var(--ease), box-shadow var(--t-med) var(--ease);
  }
  /* Karmínová linka shora (kreslí se při najetí) */
  .show::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--crimson), rgba(178, 175, 63, 0.8));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
    z-index: 3;
  }
  .show:focus-within::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .show:hover { border-color: rgba(228, 6, 7, 0.5); box-shadow: var(--shadow-1), var(--shadow-red); }
    .show:hover::after { transform: scaleX(1); }
  }

  .show__media {
    position: absolute;
    inset: 0;
    margin: 0;
    z-index: 0;
  }
  .show__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
    transition: transform var(--dur-5) var(--ease-out), filter var(--t-med) var(--ease);
  }
  .show:nth-child(1) .show__media :global(img) { object-position: center 55%; }
  .show:nth-child(2) .show__media :global(img) { object-position: center 28%; }
  .show:nth-child(3) .show__media :global(img) { object-position: center 40%; }
  .show:nth-child(4) .show__media :global(img) { object-position: center 30%; }
  @media (hover: hover) and (pointer: fine) {
    .show:hover .show__media :global(img) { transform: scale(1.05); filter: saturate(1.05) contrast(1.07); }
  }

  /* Text sedí na vlastní tmavé podložce, aby kontrast nezávisel na fotce */
  .show__body {
    position: relative;
    z-index: 1;
    padding: clamp(4.5rem, 9vw, 7rem) clamp(1.25rem, 2.6vw, 2.25rem) clamp(1.4rem, 2.6vw, 2.1rem);
    background: linear-gradient(180deg, rgba(6, 6, 6, 0) 0%, rgba(6, 6, 6, 0.82) 38%, rgba(6, 6, 6, 0.96) 100%);
  }

  .show__tag {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid rgba(178, 175, 63, 0.45);
    background: rgba(6, 6, 6, 0.5);
    padding: 0.3rem 0.7rem;
    margin-bottom: var(--sp-3);
  }
  .show__title {
    font-size: clamp(1.55rem, 2.8vw, 2.15rem);
    margin-bottom: var(--sp-3);
  }
  .show__desc {
    font-size: 0.97rem;
    line-height: 1.65;
    color: var(--ink);
    max-width: 52ch;
  }

  .show__num {
    position: absolute;
    top: clamp(0.6rem, 1.4vw, 1.1rem);
    right: clamp(1rem, 2vw, 1.6rem);
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.7);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    transition: -webkit-text-stroke-color var(--t-med) var(--ease);
  }
  @supports not (-webkit-text-stroke: 1px #000) {
    .show__num { color: var(--ink); }
  }
  @media (hover: hover) and (pointer: fine) {
    .show:hover .show__num { -webkit-text-stroke-color: var(--crimson-bright); }
  }

  .program__more { margin-top: var(--sp-7); display: flex; justify-content: flex-end; }

  @media (max-width: 1024px) {
    .program { grid-auto-rows: clamp(380px, 52vw, 460px); }
  }
  @media (max-width: 760px) {
    .program { grid-template-columns: 1fr; grid-auto-rows: minmax(420px, auto); }
    .show--wide, .show--narrow { grid-column: auto; }
    .program__more { justify-content: flex-start; }
  }
</style>
