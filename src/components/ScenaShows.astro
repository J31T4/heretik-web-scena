---
import { asset } from '../utils/paths.js';

const shows = [
  {
    title: 'Historický šerm',
    tag: 'autentika',
    description: 'Autentické vystoupení, při kterém v nácviku využíváme dochované učebnice starých šermířských mistrů.',
    image: asset('/images/gallery-1.jpeg'),
  },
  {
    title: 'Scénická vystoupení',
    tag: 'divadlo',
    description: `Vlastní choreografie, vtipné texty a scénky od commedie dell'arte až po fantastické povídky.`,
    image: asset('/images/gallery-2.jpeg'),
  },
  {
    title: 'Vystoupení na míru',
    tag: 'na zakázku',
    description: 'Připravíme vystoupení pro městské slavnosti, historické dny, plesy, firemní večírky, oslavy narozenin i dětské tábory.',
    image: asset('/images/gallery-3.jpeg'),
  },
  {
    title: 'Program pro školy',
    tag: 'ZŠ',
    description: 'Program pro základní školy, který děti nejen pobaví, ale také přiučí novým věcem o historii.',
    image: asset('/images/gallery-4.jpeg'),
  },
];
---

<section class="scena-shows section">
  <div class="container">
    <p class="section-label reveal">Co děláme</p>
    <h2 class="section-title reveal">Co hrajeme</h2>
    <div class="divider reveal"><span></span></div>

    <div class="shows__grid">
      {shows.map((show, i) => (
        <article class="show-card reveal" data-tilt>
          <div class="show-card__image">
            <img src={show.image} alt={show.title} loading="lazy" />
            <span class="show-card__tag">{show.tag}</span>
          </div>
          <div class="show-card__body">
            <span class="show-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{show.title}</h3>
            <p>{show.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // 3D tilt na kartách – jemný náklon podle myši
  (function () {
    const cards = document.querySelectorAll('[data-tilt]');
    if (!cards.length) return;

    const MAX_TILT = 6;

    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(800px) rotateY(${x * MAX_TILT}deg) rotateX(${-y * MAX_TILT}deg) translateY(-6px)`;
        card.style.transition = 'transform 0.1s ease-out';
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
        card.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
      });
    });
  })();
</script>

<style>
  .scena-shows { background: var(--bg); }

  .shows__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .show-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    position: relative;
    transition: all 0.4s var(--ease);
    overflow: hidden;
  }

  .show-card:hover {
    transform: translateY(-6px);
    border-color: var(--red);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .show-card__image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .show-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .show-card:hover .show-card__image img { transform: scale(1.08); }

  .show-card__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--red);
    color: white;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
  }

  .show-card__body {
    padding: 1.5rem 1.5rem 1.8rem;
    position: relative;
  }

  .show-card__num {
    position: absolute;
    top: 1.1rem;
    right: 1.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    color: rgba(245, 240, 235, 0.14);
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  .show-card:hover .show-card__num { color: rgba(178, 175, 63, 0.3); }

  .show-card h3 {
    margin-bottom: 0.8rem;
    font-size: 1.25rem;
    padding-right: 3.5rem; /* rezerva pro číslo vpravo */
    position: relative;
    z-index: 2;
  }

  .show-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 1024px) {
    .shows__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .shows__grid { grid-template-columns: 1fr; }
  }
</style>
