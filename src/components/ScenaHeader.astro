---
import { page, asset } from '../utils/paths.js';

const base = import.meta.env.BASE_URL;
let current = Astro.url.pathname;
current = current.startsWith(base) ? current.slice(base.length - 1) : current;
current = current === '' ? '/' : current.replace(/\/$/, '');

const stripBase = (href) => {
  let s = href;
  if (s.startsWith(base)) s = s.slice(base.length - 1);
  s = s.replace(/\/$/, '');
  return s === '' ? '/' : s;
};

const links = [
  { href: page('/o-nas'), label: 'O nás' },
  { href: page('/akce'), label: 'Co nabízíme' },
  { href: page('/galerie'), label: 'Galerie' },
  { href: page('/kontakt'), label: 'Kontakt' },
];

const isActive = (href) => stripBase(href) === current;
---

<header class="scena-header">
  <div class="container header__inner">
    <a href={page('/')} class="header__brand" aria-label="SHŠ Heretik — úvodní stránka">
      <img src={asset('/logo.svg')} alt="" class="header__logo" width="44" height="36" />
      <span class="header__brandtext">
        <span class="header__name">SHŠ Heretik</span>
        <span class="header__tagline">historický &amp; scénický šerm</span>
      </span>
    </a>

    <nav class="header__nav" id="scenaMenu" aria-label="Hlavní navigace">
      {links.map((l, i) => (
        <a
          href={l.href}
          class:list={{ 'is-active': isActive(l.href) }}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          <span class="header__nav-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {l.label}
        </a>
      ))}
      <a href={page('/kontakt')} class="btn btn--primary header__nav-cta">
        Poptat vystoupení <span class="btn__arrow">→</span>
      </a>
      <p class="header__nav-foot">Mohelnice · Česká republika</p>
    </nav>

    <a href={page('/kontakt')} class="btn btn--primary header__cta">
      Poptat vystoupení <span class="btn__arrow">→</span>
    </a>

    <button
      class="header__burger"
      id="menuToggle"
      aria-label="Otevřít menu"
      aria-controls="scenaMenu"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .scena-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: linear-gradient(180deg, rgba(6, 6, 6, 0.72), rgba(6, 6, 6, 0.2));
    border-bottom: 1px solid transparent;
    padding: var(--sp-4) 0;
    transition:
      background var(--t-med) var(--ease),
      border-color var(--t-med) var(--ease),
      padding var(--t-med) var(--ease);
  }

  .scena-header.is-scrolled {
    background: rgba(7, 7, 7, 0.82);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    backdrop-filter: blur(16px) saturate(1.15);
    border-bottom-color: var(--line);
    padding: 0.65rem 0;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 44px;
  }

  .header__logo {
    height: 40px;
    width: auto;
    filter: drop-shadow(0 0 14px rgba(178, 175, 63, 0.25));
    transition: transform var(--t-med) var(--ease-out);
  }
  .header__brand:hover .header__logo { transform: scale(1.05); }

  .header__brandtext { display: flex; flex-direction: column; line-height: 1.15; }
  .header__name {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .header__tagline {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }

  .header__nav a:not(.btn) {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding: 0.5rem 0.15rem;
    transition: color var(--t-fast) var(--ease);
  }

  .header__nav a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.1rem;
    height: 1px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-med) var(--ease-out);
  }

  .header__nav a:not(.btn):hover,
  .header__nav a:not(.btn).is-active {
    color: var(--ink);
  }
  .header__nav a:not(.btn):hover::after,
  .header__nav a:not(.btn).is-active::after { transform: scaleX(1); }

  .header__nav-num {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    color: var(--crimson);
    opacity: 0;
    transition: opacity var(--t-fast) var(--ease);
  }
  .header__nav a.is-active .header__nav-num { opacity: 1; }

  .header__cta { margin-left: var(--sp-3); }

  .header__nav-cta { display: none; }
  .header__nav-foot { display: none; }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 48px;
    height: 48px;
    padding: 0.6rem;
    border: 1px solid var(--line-2);
    background: rgba(10, 10, 10, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    z-index: calc(var(--z-menu) + 1);
    transition: border-color var(--t-fast) var(--ease);
  }
  .header__burger:hover { border-color: var(--crimson); }

  .header__burger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink);
    transition: transform var(--t-med) var(--ease-out), opacity var(--t-fast) var(--ease);
    transform-origin: center;
  }
  .header__burger.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__burger.active span:nth-child(2) { opacity: 0; }
  .header__burger.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 900px) {
    .scena-header { padding: 0.55rem 0; }
    .scena-header.is-scrolled { padding: 0.4rem 0; }
    .header__cta { display: none; }
    .header__burger { display: flex; }

    .header__nav {
      position: fixed;
      inset: 0;
      z-index: var(--z-menu);
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0;
      padding: calc(5rem + env(safe-area-inset-top)) var(--gutter) 2rem;
      background:
        radial-gradient(ellipse 90% 50% at 80% 0%, rgba(228, 6, 7, 0.09), transparent 55%),
        rgba(7, 7, 7, 0.96);
      -webkit-backdrop-filter: blur(22px);
      backdrop-filter: blur(22px);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-1.5%);
      transition: opacity var(--t-med) var(--ease), transform var(--t-med) var(--ease-out), visibility 0s linear var(--t-med);
    }

    .header__nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      transition: opacity var(--t-med) var(--ease), transform var(--t-med) var(--ease-out), visibility 0s;
    }

    .header__nav a:not(.btn) {
      font-family: var(--font-display);
      font-size: clamp(2rem, 8vw, 2.9rem);
      font-weight: 500;
      letter-spacing: 0.01em;
      text-transform: none;
      color: var(--ink);
      padding: 0.65rem 0;
      gap: 1rem;
    }
    .header__nav a:not(.btn)::after { display: none; }

    .header__nav-num {
      font-family: var(--font-ui);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      opacity: 1;
      color: var(--crimson);
      transform: translateY(-0.5em);
    }
    .header__nav a.is-active { color: var(--crimson-bright); }
    .header__nav a.is-active .header__nav-num { color: var(--crimson); }

    .header__nav-cta {
      display: inline-flex;
      margin-top: var(--sp-6);
    }

    .header__nav-foot {
      display: block;
      position: absolute;
      bottom: calc(2rem + env(safe-area-inset-bottom));
      left: var(--gutter);
      font-family: var(--font-ui);
      font-size: var(--fs-micro);
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
  }
</style>
