---
import { page, asset } from '../utils/paths.js';
---

<header class="scena-header">
  <div class="container header__inner">
    <a href={page('/')} class="header__brand">
      <img src={asset('/logo.svg')} alt="SHŠ Heretik" class="header__logo" />
      <span class="header__name">SHŠ Heretik</span>
    </a>
    <nav class="header__nav" id="scenaNav">
      <a href={page('/o-nas')}>Dějství I</a>
      <a href={page('/akce')}>Dějství II</a>
      <a href={page('/galerie')}>Dějství III</a>
      <a href={page('/kontakt')}>Dějství IV</a>
    </nav>
    <a href={page('/kontakt')} class="btn btn--primary header__cta">Poptat vystoupení</a>
    <button class="header__burger" id="scenaBurger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const burger = document.getElementById('scenaBurger');
  const nav = document.getElementById('scenaNav');

  if (burger && nav) {
    burger.addEventListener('click', () => {
      burger.classList.toggle('active');
      nav.classList.toggle('open');
    });
    nav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        burger.classList.remove('active');
        nav.classList.remove('open');
      });
    });
  }
</script>

<style>
  .scena-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 10, 10, 0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header__logo { height: 44px; width: auto; }

  .header__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.02em;
  }

  .header__nav {
    display: flex;
    gap: 1.8rem;
  }

  .header__nav a {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color 0.3s var(--ease);
  }

  .header__nav a:hover { color: var(--red); }

  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 101;
  }

  .header__burger span {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--text);
    transition: all 0.3s var(--ease);
    transform-origin: center;
  }

  .header__burger.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__burger.active span:nth-child(2) { opacity: 0; }
  .header__burger.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 900px) {
    .header__nav {
      position: fixed;
      top: 0;
      right: 0;
      width: 300px;
      height: 100vh;
      background: var(--bg-card);
      border-left: 1px solid var(--border);
      flex-direction: column;
      padding: 6rem 2.5rem 2rem;
      gap: 2rem;
      transform: translateX(100%);
      transition: transform 0.4s var(--ease-out);
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.6);
    }

    .header__nav.open { transform: translateX(0); }

    .header__nav a { font-size: 1rem; color: var(--text); }

    .header__cta { display: none; }

    .header__burger { display: flex; }
  }
</style>
