---
import { cs } from '../utils/typo.js';
import Picture from './Picture.astro';

interface Props {
  label: string;
  act: string;
  title: string;
  subtitle?: string;
  variant?: 'standard' | 'split' | 'minimal';
  image?: {
    jpg: string;
    alt: string;
    position?: 'high' | 'mid';
  };
}

const { label, act, title, subtitle, variant = 'standard', image } = Astro.props;
---

<section class:list={['scena-page-hero', `scena-page-hero--${variant}`]}>
  {variant === 'standard' && image && (
    <>
      <div class="page-hero__bg" aria-hidden="true">
        <Picture
          src={image.jpg}
          alt=""
          imgClass={image.position ? `page-hero__image--${image.position}` : undefined}
          width={1400}
          height={934}
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
        />
        <div class="page-hero__veil"></div>
      </div>
      <div class="grain" aria-hidden="true"></div>
      <div class="container page-hero__text">
        <p class="act-label reveal">{act}</p>
        <p class="section-label reveal">{label}</p>
        <h1 class="page-hero__title reveal" set:html={cs(title)} />
        {subtitle && <p class="page-hero__subtitle reveal" set:html={cs(subtitle)} />}
      </div>
    </>
  )}

  {variant === 'split' && image && (
    <div class="container page-hero__split">
      <div class="page-hero__text">
        <p class="act-label reveal">{act}</p>
        <p class="section-label reveal">{label}</p>
        <h1 class="page-hero__title reveal">{cs(title)}</h1>
        {subtitle && <p class="page-hero__subtitle reveal">{cs(subtitle)}</p>}
      </div>
      <figure class="page-hero__figure reveal reveal--zoom">
        <div class="page-hero__frame" aria-hidden="true"></div>
        <Picture
          src={image.jpg}
          alt={image.alt}
          width={1050}
          height={1400}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 900px) 100vw, 460px"
        />
        <figcaption class="page-hero__figcap">
          <span aria-hidden="true">◆</span> {label}
        </figcaption>
      </figure>
    </div>
  )}

  {variant === 'minimal' && (
    <div class="container page-hero__minimal">
      <p class="act-label reveal">{act}</p>
      <p class="section-label reveal">{label}</p>
      <h1 class="page-hero__title reveal" set:html={cs(title)} />
      {subtitle && <p class="page-hero__subtitle reveal" set:html={cs(subtitle)} />}
    </div>
  )}
</section>

<style>
  .scena-page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }

  /* --- Standardní varianta: celoplošné pozadí --- */
  .scena-page-hero--standard {
    min-height: 56vh;
    display: flex;
    align-items: flex-end;
    padding: var(--sp-9) 0 var(--sp-8);
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .page-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.page-hero__image--high) { object-position: center 25%; }
  :global(.page-hero__image--mid) { object-position: center 40%; }
  .page-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 6, 6, 0.88) 0%, rgba(6, 6, 6, 0.35) 40%, rgba(6, 6, 6, 0.9) 100%),
      linear-gradient(90deg, rgba(6, 6, 6, 0.55) 0%, transparent 60%);
  }
  .scena-page-hero--standard .container { position: relative; z-index: 2; }
  .scena-page-hero--standard .act-label { margin-bottom: var(--sp-4); }
  .scena-page-hero--standard .section-label { margin-bottom: var(--sp-3); }

  /* --- Split varianta: text + rámovaná fotka --- */
  .scena-page-hero--split {
    padding: var(--sp-9) 0;
    background:
      radial-gradient(ellipse 55% 90% at 90% 10%, rgba(228, 6, 7, 0.07), transparent 60%),
      var(--bg-0);
  }
  .page-hero__split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .page-hero__text .act-label { margin-bottom: var(--sp-4); }
  .page-hero__text .section-label { margin-bottom: var(--sp-3); }

  .page-hero__figure {
    margin: 0;
    position: relative;
    max-width: 460px;
    justify-self: end;
    width: 100%;
  }
  .page-hero__figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line-2);
    filter: saturate(0.9) contrast(1.06);
  }
  .page-hero__frame {
    position: absolute;
    inset: -14px 14px 14px -14px;
    border: 1px solid var(--line-2);
    z-index: -1;
  }
  .page-hero__frame::after {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 44px;
    height: 1px;
    background: var(--crimson);
    box-shadow: 0 0 12px var(--crimson-glow);
  }
  .page-hero__figcap {
    position: absolute;
    right: -1.2rem;
    bottom: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold);
    background: var(--bg);
    border: 1px solid var(--line-2);
    padding: 0.55rem 0.9rem;
  }

  /* --- Minimal varianta --- */
  .scena-page-hero--minimal {
    padding: var(--sp-9) 0 var(--sp-8);
    background:
      radial-gradient(ellipse 60% 80% at 20% 0%, rgba(228, 6, 7, 0.06), transparent 55%),
      var(--bg-0);
  }
  .page-hero__minimal .act-label { margin-bottom: var(--sp-4); }
  .page-hero__minimal .section-label { margin-bottom: var(--sp-3); }

  /* --- Společné typo --- */
  .page-hero__title {
    font-size: clamp(2.8rem, 7.5vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-4);
  }
  .page-hero__subtitle {
    font-size: var(--fs-lead);
    color: var(--ink-2);
    max-width: 520px;
  }

  @media (max-width: 900px) {
    .scena-page-hero--standard { min-height: 48vh; }
    .page-hero__split { grid-template-columns: 1fr; }
    .page-hero__figure { justify-self: start; max-width: 400px; }
    .page-hero__frame { inset: -10px 10px 10px -10px; }
    /* Popisek uvnitř rámu, ať není na mobilu oříznutý okrajem viewportu */
    .page-hero__figcap { right: 0.6rem; bottom: 0.6rem; }
  }
</style>
