---
import { cs } from '../utils/typo.js';
import Picture from './Picture.astro';
import Blade from './Blade.astro';

interface Props {
  label: string;
  act: string;
  title: string;
  subtitle?: string;
  variant?: 'standard' | 'split' | 'minimal';
  /** Obrysový typografický prvek (jen split/minimal): velká hodnota + popisek.
   *  Čtečka přečte hodnotu i popisek jako jednu větu („2020 Rok vzniku spolku“). */
  emblem?: { value: string; caption: string };
  image?: {
    jpg: string;
    alt: string;
    position?: 'high' | 'mid';
    /** Reálné rozměry plné varianty (kvůli CLS); default 1400×934 / 1050×1400 */
    w?: number;
    h?: number;
  };
}

const { label, act, title, subtitle, variant = 'standard', image, emblem } = Astro.props;
// `act` má tvar „I. dějství · Název“ — do kickeru jde jen část před tečkou-oddělovačem.
const actName = act.split(' · ')[0];
---

<section class:list={['scena-page-hero', `scena-page-hero--${variant}`]}>
  {variant === 'standard' && image && (
    <>
      <div class="page-hero__bg" aria-hidden="true">
        <Picture
          src={image.jpg}
          alt=""
          imgClass={image.position ? `page-hero__image--${image.position}` : undefined}
          width={image.w ?? 1400}
          height={image.h ?? 934}
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
        />
        <div class="page-hero__veil"></div>
      </div>
      <div class="grain" aria-hidden="true"></div>
      <div class="container page-hero__text">
        <p class="kicker reveal"><span class="kicker__act">{actName}</span><span class="kicker__label">{label}</span></p>
        <h1 class="page-hero__title reveal">{cs(title)}</h1>
        <Blade class="page-hero__blade reveal" />
        {subtitle && <p class="page-hero__subtitle reveal">{cs(subtitle)}</p>}
      </div>
    </>
  )}

  {variant === 'split' && image && (
    <div class="container page-hero__split">
      <div class="page-hero__text">
        <p class="kicker reveal"><span class="kicker__act">{actName}</span><span class="kicker__label">{label}</span></p>
        <h1 class="page-hero__title reveal">{cs(title)}</h1>
        <Blade class="page-hero__blade reveal" />
        {subtitle && <p class="page-hero__subtitle reveal">{cs(subtitle)}</p>}
        {emblem && (
          <p class="page-hero__emblem reveal">
            <span class="page-hero__emblem-value">{emblem.value}</span>
            <span class="page-hero__emblem-caption">{cs(emblem.caption)}</span>
          </p>
        )}
      </div>
      <figure class="page-hero__figure reveal reveal--zoom">
        <div class="page-hero__frame" aria-hidden="true"></div>
        <Picture
          src={image.jpg}
          alt={image.alt}
          width={image.w ?? 1050}
          height={image.h ?? 1400}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 900px) 100vw, 460px"
        />
        <figcaption class="page-hero__figcap">
          <span aria-hidden="true">◆</span> {label}
        </figcaption>
      </figure>
    </div>
  )}

  {variant === 'minimal' && (
    <div class="container page-hero__minimal">
      <div class="page-hero__text">
        <p class="kicker reveal"><span class="kicker__act">{actName}</span><span class="kicker__label">{label}</span></p>
        <h1 class="page-hero__title reveal">{cs(title)}</h1>
        <Blade class="page-hero__blade reveal" />
        {subtitle && <p class="page-hero__subtitle reveal">{cs(subtitle)}</p>}
      </div>
      {emblem && (
        <p class="page-hero__emblem reveal">
          <span class="page-hero__emblem-value">{emblem.value}</span>
          <span class="page-hero__emblem-caption">{cs(emblem.caption)}</span>
        </p>
      )}
    </div>
  )}
</section>

<style>
  .scena-page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }

  /* --- Společné typo: H1 výrazně nad sekčními h2, verzálky ve všech variantách --- */
  .page-hero__title {
    font-size: clamp(2.5rem, 9vw, 6.6rem);
    line-height: 0.98;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    margin-bottom: var(--sp-4);
    overflow-wrap: break-word;
  }
  :global(.page-hero__blade) { margin-bottom: var(--sp-5); }
  .page-hero__subtitle {
    font-size: var(--fs-lead);
    color: var(--ink-2);
    max-width: 520px;
  }

  /* Obrysový prvek (rok / počet) — jazyk čísel na kartách programu */
  .page-hero__emblem {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }
  .page-hero__emblem-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(5.5rem, 15vw, 12rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.5);
    user-select: none;
  }
  @supports not (-webkit-text-stroke: 1px #000) {
    .page-hero__emblem-value { color: var(--ink-3); }
  }
  .page-hero__emblem-caption {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .page-hero__emblem-caption::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  /* --- Standardní varianta: celoplošné pozadí, plynulé splynutí do první sekce --- */
  .scena-page-hero--standard {
    min-height: 62vh;
    display: flex;
    align-items: flex-end;
    padding: var(--sp-9) 0 var(--sp-8);
    border-bottom: 0;
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .page-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.page-hero__image--high) { object-position: center 25%; }
  :global(.page-hero__image--mid) { object-position: center 40%; }
  /* Fotka je nahoře vidět (jen lehký závoj pro hlavičku), text dole sedí na téměř plné tmě;
     spodek splývá s pozadím další sekce (--bg-0). */
  .page-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 6, 6, 0.62) 0%, rgba(6, 6, 6, 0.06) 22%, rgba(6, 6, 6, 0.5) 46%, rgba(6, 6, 6, 0.92) 74%, var(--bg-0) 100%),
      linear-gradient(90deg, rgba(6, 6, 6, 0.7) 0%, rgba(6, 6, 6, 0.25) 45%, transparent 70%);
  }
  .scena-page-hero--standard .container { position: relative; z-index: 2; width: 100%; }
  /* Na fotce (různá světlost pod textem) kicker záměrně zůstává slonovinový – bezpečný kontrast */
  .scena-page-hero--standard .kicker { text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9); }
  .scena-page-hero--standard .kicker__act { color: var(--ink); }
  .scena-page-hero--standard .page-hero__title { text-shadow: 0 4px 40px rgba(0, 0, 0, 0.6); }

  /* --- Split varianta: text + rámovaná fotka --- */
  .scena-page-hero--split {
    padding: var(--sp-8) 0 var(--sp-9);
    background:
      radial-gradient(ellipse 50% 80% at 88% 30%, rgba(228, 6, 7, 0.11), transparent 62%),
      radial-gradient(ellipse 40% 60% at 0% 100%, rgba(178, 175, 63, 0.05), transparent 70%),
      var(--bg-0);
  }
  .page-hero__split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .page-hero__figure {
    margin: 0;
    position: relative;
    max-width: 440px;
    justify-self: end;
    width: 100%;
    isolation: isolate;
  }
  .page-hero__figure :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 62%;
    display: block;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-card);
    filter: saturate(0.9) contrast(1.06);
  }
  .page-hero__frame {
    position: absolute;
    inset: -14px 14px 14px -14px;
    border: 1px solid var(--line-2);
    z-index: -1;
  }
  .page-hero__frame::after {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 44px;
    height: 2px;
    background: var(--crimson);
    box-shadow: 0 0 14px var(--crimson-glow);
  }
  .page-hero__figcap {
    position: absolute;
    right: -1.2rem;
    bottom: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold);
    background: var(--bg);
    border: 1px solid var(--line-2);
    box-shadow: var(--edge-light), var(--shadow-1);
    padding: 0.55rem 0.9rem;
    white-space: nowrap;
  }

  /* --- Minimal varianta: text vlevo, obrysový údaj vpravo na účaří --- */
  .scena-page-hero--minimal {
    padding: var(--sp-9) 0 var(--sp-8);
    background:
      radial-gradient(ellipse 60% 80% at 20% 0%, rgba(228, 6, 7, 0.08), transparent 55%),
      radial-gradient(ellipse 40% 70% at 100% 100%, rgba(178, 175, 63, 0.05), transparent 70%),
      var(--bg-0);
  }
  .page-hero__minimal {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--sp-7);
    align-items: end;
  }
  .page-hero__minimal .page-hero__emblem { margin-top: 0; align-items: flex-end; text-align: right; }

  @media (max-width: 900px) {
    .scena-page-hero--standard { min-height: 54vh; }
    .page-hero__split { grid-template-columns: 1fr; }
    .page-hero__figure { justify-self: start; max-width: 400px; margin-right: 14px; }
    .page-hero__frame { inset: -10px 10px 10px -10px; }
    /* Popisek uvnitř rámu, ať není na mobilu oříznutý okrajem viewportu */
    .page-hero__figcap { right: 0.6rem; bottom: 0.6rem; }
    .page-hero__minimal { grid-template-columns: 1fr; row-gap: var(--sp-5); }
    .page-hero__minimal .page-hero__emblem { align-items: flex-start; text-align: left; }
    .page-hero__emblem { margin-top: var(--sp-5); }
  }
</style>
