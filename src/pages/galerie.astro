---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaPageHero from '../components/ScenaPageHero.astro';
import ScenaGallery from '../components/ScenaGallery.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
---

<ScenaLayout
  title="Galerie"
  description="Fotografie ze šermířských vystoupení SHŠ Heretik — souboje, dobová ležení a scény z našich představení."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaPageHero
      variant="minimal"
      act="III. dějství · Galerie"
      label="Fotografie"
      title="GALERIE"
      subtitle="Momenty ze soubojů, táborů a našich vystoupení."
    />
    <ScenaGallery act="" />
  </main>
  <ScenaFooter />
</ScenaLayout>
