---
import BaseLayout from '../layouts/BaseLayout.astro';
import { asset } from '../utils/paths.js';

const images = [
  asset('/images/gallery-1.jpeg'),
  asset('/images/gallery-2.jpeg'),
  asset('/images/gallery-3.jpeg'),
  asset('/images/gallery-4.jpeg'),
  asset('/images/gallery-5.jpeg'),
  asset('/images/gallery-6.jpeg'),
  asset('/images/gallery-7.jpeg'),
  asset('/images/gallery-8.jpeg'),
];
---

<BaseLayout title="Galerie" description="Fotogalerie z vystoupení SHŠ Heretik.">
  <section class="page-hero">
    <div class="container">
      <h1>GALERIE</h1>
      <p>Fotky z našich vystoupení</p>
    </div>
  </section>
  
  <section class="gallery section">
    <div class="container">
      <div class="gallery__grid">
        {images.map((src, index) => (
          <div class="gallery__item">
            <img src={src} alt={`Fotografie z vystoupení ${index + 1}`} loading="lazy" />
          </div>
        ))}
      </div>
      
      <div class="gallery__info">
        <h2>Videa připravujeme</h2>
        <p>
          Pracujeme na videosekvencích z našich vystoupení. Brzy je zde přidáme, 
          abyste si mohli užít atmosféru i z pohyblivých záznamů.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 10rem 0 4rem;
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
    text-align: center;
  }
  
  .page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
  }
  
  .page-hero p {
    color: var(--color-text-muted);
    font-size: 1.25rem;
  }
  
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 4rem;
  }
  
  .gallery__item {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-lg);
    transition: all var(--transition);
  }
  
  .gallery__item:hover {
    transform: scale(1.02);
  }
  
  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.3s ease;
  }
  
  .gallery__item:hover img {
    filter: brightness(1.1);
  }
  
  .gallery__info {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  
  .gallery__info h2 {
    margin-bottom: 1rem;
  }
  
  .gallery__info p {
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }
  
  @media (max-width: 640px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>
