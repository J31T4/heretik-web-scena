---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaPageHero from '../components/ScenaPageHero.astro';
import ScenaGallery from '../components/ScenaGallery.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
import ScenaCTA from '../components/ScenaCTA.astro';
import { galleryCount } from '../data/gallery.js';
---

<ScenaLayout
  title="Galerie"
  image={{ src: '/images/opt/gallery-21.jpg', width: 1400, height: 932, alt: 'Usměvavý šermíř ve fialovém kabátě zkříží čepel se soupeřem' }}
  description="Fotografie ze šermířských vystoupení SHŠ Heretik – souboje, dobová ležení a scény z našich představení."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaPageHero
      variant="minimal"
      act="III. dějství · Galerie"
      label="Fotografie"
      title="Galerie"
      subtitle="Momenty ze soubojů, táborů a našich vystoupení."
      emblem={{ value: String(galleryCount), caption: 'fotografií v galerii' }}
    />
    <ScenaGallery act="" extended />
    <ScenaCTA
      title="Fotky jsou jen začátek"
      titleAccent="pozvěte nás na svou akci"
    />
  </main>
  <ScenaFooter />
</ScenaLayout>
