---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaHero from '../components/ScenaHero.astro';
import ScenaInstagram from '../components/ScenaInstagram.astro';
import ScenaShows from '../components/ScenaShows.astro';
import ScenaQuote from '../components/ScenaQuote.astro';
import ScenaGallery from '../components/ScenaGallery.astro';
import ScenaCTA from '../components/ScenaCTA.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
---

<ScenaLayout
  title="Domů"
  description="Historický a scénický šerm z Mohelnice. Vlastní choreografie, dobové techniky a vystoupení pro slavnosti, plesy i školy."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaHero />
    <ScenaInstagram />
    <ScenaShows />
    <ScenaQuote />
    <ScenaGallery />
    <ScenaCTA />
  </main>
  <ScenaFooter />
</ScenaLayout>
