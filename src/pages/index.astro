---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaHero from '../components/ScenaHero.astro';
import ScenaMarquee from '../components/ScenaMarquee.astro';
import ScenaShows from '../components/ScenaShows.astro';
import ScenaTimeline from '../components/ScenaTimeline.astro';
import ScenaGallery from '../components/ScenaGallery.astro';
import ScenaCTA from '../components/ScenaCTA.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
---

<ScenaLayout title="Domů">
  <ScenaHeader />
  <main>
    <ScenaHero />
    <ScenaMarquee />
    <ScenaShows />
    <ScenaTimeline />
    <ScenaGallery />
    <ScenaCTA />
  </main>
  <ScenaFooter />
</ScenaLayout>
