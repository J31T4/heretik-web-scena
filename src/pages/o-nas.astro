---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaPageHero from '../components/ScenaPageHero.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
import Picture from '../components/Picture.astro';
import { cs } from '../utils/typo.js';
---

<ScenaLayout
  title="O nás"
  description="Spolek HERETIK vznikl v roce 2020. Věnujeme se studiu dobových technik, nácviku a předvádění historického i scénického šermu."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaPageHero
      variant="split"
      act="Předehra · O nás"
      label="Kdo jsme"
      title="O NÁS"
      subtitle="Příběh naší vášně pro historii a šerm"
      image={{
        jpg: '/images/opt/gallery-8.jpg',
        alt: 'Skupina SHŠ Heretik v kostýmech před kamenným obloukem',
      }}
    />

    <section class="about-block section">
      <div class="container about__grid">
        <div class="about__text reveal">
          <span class="about__num" aria-hidden="true">01</span>
          <h2 class="about__title">Naše historie</h2>
          <p set:html={cs('Spolek HERETIK vznikl v roce 2020. Zabývá se tvorbou vystoupení, studiem dobových technik, nácvikem a předváděním šermu. Naši členové mají letitou praxi a zkušenosti z jiných šermířských skupin.')} />
          <p set:html={cs('Tvoříme si vlastní choreografie, vtipné texty a scénky z odlišných druhů performancí – od commedie dell\'arte až po různé fantastické povídky.')} />
        </div>
        <figure class="about__image reveal reveal--zoom">
          <Picture
            src="/images/opt/gallery-1.jpg"
            alt="Historické tábořiště se šermířskou skupinou"
            width={1400}
            height={666}
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="about-block section section--tint">
      <div class="container about__grid about__grid--reverse">
        <figure class="about__image reveal reveal--zoom">
          <Picture
            src="/images/opt/gallery-2.jpg"
            alt="Šermířská škola – ležení se stany"
            width={1400}
            height={915}
            loading="lazy"
          />
        </figure>
        <div class="about__text reveal">
          <span class="about__num" aria-hidden="true">02</span>
          <h2 class="about__title">Šermířská škola</h2>
          <p set:html={cs('V nácviku nám pomáhají dochované učebnice starých šermířských mistrů i různé školy šermu. Absolvovali jsme několik seminářů, které se drží odkazu šermířského mistra Petra Kozy, který nám předal zkušený lektor Martin Tureček.')} />
          <p set:html={cs('Šerm není jen bojové umění – je to forma choreografického vystoupení, kde každý pohyb, každá pozice a každý výraz má svůj význam.')} />
        </div>
      </div>
    </section>

    <section class="about-block section section--framed">
      <div class="container about__grid">
        <div class="about__text reveal">
          <span class="about__num" aria-hidden="true">03</span>
          <h2 class="about__title">Pro vaše akce</h2>
          <p set:html={cs('Dle vašich potřeb jsme schopni připravit vystoupení pro městské slavnosti, historické dny a v neposlední řadě také obstaráme program pro plesy, firemní večírky a oslavy narozenin.')} />
          <p set:html={cs('Připravíme také program pro dětské tábory a základní školy – děti nejen pobaví, ale také přiučí novým věcem o historii.')} />
        </div>
        <figure class="about__image reveal reveal--zoom">
          <Picture
            src="/images/opt/gallery-6.jpg"
            alt="Šermíři v kostýmech před hradní zdí"
            width={1400}
            height={933}
            loading="lazy"
          />
        </figure>
      </div>
    </section>
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .about__grid--reverse .about__image { order: -1; }

  .about__image {
    margin: 0;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-2);
  }
  .about__image :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(0.9) contrast(1.05);
    transition: transform var(--dur-4) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .about__image:hover :global(img) { transform: scale(1.045); }
  }

  .about__text { position: relative; padding-top: var(--sp-6); }

  .about__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--crimson-bright);
    letter-spacing: 0.2em;
    border: 1px solid rgba(228, 6, 7, 0.4);
    padding: 0.35rem 0.7rem;
    margin-bottom: var(--sp-5);
    display: inline-block;
  }

  .about__title {
    margin-bottom: var(--sp-5);
    position: relative;
    padding-left: 1.2rem;
  }
  .about__title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.18em;
    bottom: 0.18em;
    width: 3px;
    background: linear-gradient(180deg, var(--crimson), rgba(228, 6, 7, 0.15));
  }

  .about__text p { margin-bottom: var(--sp-4); }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; gap: var(--sp-6); }
    .about__grid--reverse .about__image { order: 0; }
  }
</style>
