---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaPageHero from '../components/ScenaPageHero.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
import ScenaCTA from '../components/ScenaCTA.astro';
import Picture from '../components/Picture.astro';
import Blade from '../components/Blade.astro';
import { cs } from '../utils/typo.js';
---

<ScenaLayout
  title="O nás"
  image={{ src: '/images/opt/gallery-28.jpg', width: 1400, height: 932, alt: 'Dva šermíři se střetávají v souboji s meči' }}
  description="Spolek HERETIK vznikl v roce 2020. Věnujeme se studiu dobových technik, nácviku a předvádění historického i scénického šermu."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaPageHero
      variant="split"
      act="II. dějství · O nás"
      label="Kdo jsme"
      title="O nás"
      subtitle="Příběh naší vášně pro historii a šerm"
      emblem={{ value: '2020', caption: 'Rok vzniku spolku' }}
      image={{
        jpg: '/images/opt/gallery-14.jpg',
        alt: 'Dva členové SHŠ Heretik v dobových kostýmech',
        w: 646,
        h: 1400,
      }}
    />

    <section class="about-block section">
      <div class="container about__grid">
        <div class="about__text reveal">
          <p class="kicker"><span class="kicker__act">1. scéna</span><span class="kicker__label">Příběh</span></p>
          <h2 class="section-title about__title">Naše historie</h2>
          <p class="about__lead">{cs('Spolek HERETIK vznikl v roce 2020. Zabývá se tvorbou vystoupení, studiem dobových technik, nácvikem a předváděním šermu. Naši členové mají letitou praxi a zkušenosti z jiných šermířských skupin.')}</p>
          <p>{cs('Tvoříme si vlastní choreografie, vtipné texty a scénky z odlišných druhů performancí – od commedie dell\'arte až po různé fantastické povídky.')}</p>
        </div>
        <figure class="about__image reveal reveal--zoom">
          <Picture
            src="/images/opt/gallery-1.jpg"
            alt="Historické tábořiště se šermířskou skupinou"
            width={1400}
            height={666}
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 50vw"
          />
          <span class="about__num" aria-hidden="true">01</span>
        </figure>
      </div>
    </section>

    <section class="about-block section section--tint">
      <div class="container about__grid about__grid--reverse">
        <figure class="about__image reveal reveal--zoom">
          <Picture
            src="/images/opt/gallery-2.jpg"
            alt="Šermířská škola – ležení se stany"
            width={1400}
            height={915}
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 50vw"
          />
          <span class="about__num" aria-hidden="true">02</span>
        </figure>
        <div class="about__text reveal">
          <p class="kicker"><span class="kicker__act">2. scéna</span><span class="kicker__label">Řemeslo</span></p>
          <h2 class="section-title about__title">Šermířská škola</h2>
          <p class="about__lead">{cs('V nácviku nám pomáhají dochované učebnice starých šermířských mistrů i různé školy šermu. Absolvovali jsme také několik seminářů vedených zkušeným lektorem Martinem Turečkem, který navazuje na odkaz šermířského mistra Petra Kozy.')}</p>
        </div>
      </div>
    </section>

    <section class="about-pull paper section">
      <div class="container">
        <Blade center class="reveal" />
        <blockquote class="about-pull__text reveal">{cs('Šerm není jen bojové umění – je to forma choreografického vystoupení, kde každý pohyb, každá pozice a každý výraz má svůj význam.')}</blockquote>
        <p class="about-pull__by reveal">SHŠ Heretik</p>
      </div>
      <div class="grain" aria-hidden="true"></div>
    </section>

    <section class="about-block section section--framed">
      <div class="container about__grid">
        <div class="about__text reveal">
          <p class="kicker"><span class="kicker__act">3. scéna</span><span class="kicker__label">Nabídka</span></p>
          <h2 class="section-title about__title">Pro vaše akce</h2>
          <p class="about__lead">{cs('Dle vašich potřeb jsme schopni připravit vystoupení pro městské slavnosti, historické dny a v neposlední řadě také obstaráme program pro plesy, firemní večírky a oslavy narozenin.')}</p>
          <p>{cs('Připravíme také program pro dětské tábory a základní školy – děti nejen pobaví, ale také přiučí novým věcem o historii.')}</p>
        </div>
        <figure class="about__image reveal reveal--zoom">
          <Picture
            src="/images/opt/gallery-28.jpg"
            alt="Dva šermíři se střetávají v souboji s meči"
            width={1400}
            height={932}
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 50vw"
          />
          <span class="about__num" aria-hidden="true">03</span>
        </figure>
      </div>
    </section>
    <ScenaCTA />
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .about__grid--reverse .about__image { order: -1; }

  .about__image {
    margin: 0;
    position: relative;
    isolation: isolate;
  }
  /* Posunutý rámeček za fotkou */
  .about__image::before {
    content: '';
    position: absolute;
    inset: 16px -16px -16px 16px;
    border: 1px solid var(--line-2);
    z-index: -1;
    transition: transform var(--t-med) var(--ease-out);
  }
  .about__image::after {
    content: '';
    position: absolute;
    top: 16px;
    right: -16px;
    width: 46px;
    height: 2px;
    background: var(--crimson);
    box-shadow: 0 0 14px var(--crimson-glow);
  }
  .about__grid--reverse .about__image::before { inset: 16px 16px -16px -16px; }
  .about__grid--reverse .about__image::after { right: auto; left: -16px; }
  @media (hover: hover) and (pointer: fine) {
    .about__image:hover::before { transform: translate(-6px, -6px); }
    .about__grid--reverse .about__image:hover::before { transform: translate(6px, -6px); }
  }
  .about__image :global(picture) {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line-2);
    box-shadow: var(--edge-light), var(--shadow-card);
  }
  .about__image :global(picture)::after {
    /* spodní závoj, aby obrysové číslo drželo kontrast i na světlých fotkách */
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(200deg, rgba(6, 6, 6, 0.55) 0%, transparent 38%);
  }
  .about__image :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(0.9) contrast(1.05);
    transition: transform var(--dur-4) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .about__image:hover :global(img) { transform: scale(1.045); }
    .about__image:hover .about__num { -webkit-text-stroke-color: var(--accent-text); }
  }

  /* Obrysové číslo scény přes roh fotky — stejný jazyk jako karty programu na úvodu */
  .about__num {
    position: absolute;
    z-index: 2;
    top: clamp(0.5rem, 1.2vw, 0.9rem);
    right: clamp(0.9rem, 1.8vw, 1.4rem);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.75);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    user-select: none;
    font-variant-numeric: lining-nums tabular-nums;
    transition: -webkit-text-stroke-color var(--t-med) var(--ease);
  }
  @supports not (-webkit-text-stroke: 1px #000) {
    .about__num { color: var(--ink); }
  }

  .about__title { font-size: clamp(2.3rem, 4.4vw, 3.6rem); }
  .about__text p { margin-bottom: var(--sp-4); }
  .about__lead { font-size: var(--fs-lead); color: var(--ink); line-height: 1.7; }

  /* --- Citát na pergamenu --- */
  .about-pull { text-align: center; overflow: hidden; border-block: 1px solid var(--color-paper-2); }
  .about-pull .container { position: relative; z-index: 1; }
  .about-pull :global(.blade) { margin-bottom: var(--sp-6); }
  .about-pull__text {
    max-width: 22em;
    margin: 0 auto var(--sp-5);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.4vw, 3.4rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-paper-ink);
    text-wrap: balance;
  }
  .about-pull__by {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-paper-crimson);
  }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; gap: var(--sp-7); }
    .about__image { margin-right: 16px; }
    .about__grid--reverse .about__image { margin-right: 0; margin-left: 16px; order: 0; }
  }
</style>
