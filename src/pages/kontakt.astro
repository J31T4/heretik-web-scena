---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
---

<ScenaLayout title="Kontakt">
  <ScenaHeader />
  <main>
    <section class="scena-page-hero">
      <div class="container">
        <p class="section-label reveal">Dějství IV</p>
        <h1 class="page-title reveal">KONTAKT</h1>
        <p class="page-subtitle reveal">Domluvte si s námi představení</p>
      </div>
    </section>

    <section class="section">
      <div class="container contact__grid">
        <div class="contact__form-wrap reveal">
          <h2 class="contact__heading">Poptat vystoupení</h2>
          <form class="contact__form" action="mailto:info@shsheretik.cz" method="POST" enctype="text/plain">
            <div class="form-group">
              <label for="event-type">Typ akce</label>
              <select id="event-type" name="event-type">
                <option value="">Vyberte typ akce</option>
                <option value="mestska-slavnost">Městská slavnost</option>
                <option value="historicky-den">Historický den</option>
                <option value="ples">Ples</option>
                <option value="firemni-akce">Firemní večírek</option>
                <option value="oslava">Oslava narozenin</option>
                <option value="deticky-tabor">Dětský tábor</option>
                <option value="skolni-program">Školní program</option>
                <option value="jine">Jiné</option>
              </select>
            </div>

            <div class="form-group">
              <label for="date">Datum</label>
              <input type="date" id="date" name="date" />
            </div>

            <div class="form-group">
              <label for="location">Lokalita</label>
              <input type="text" id="location" name="location" placeholder="Město nebo místo" />
            </div>

            <div class="form-group">
              <label for="message">Zpráva</label>
              <textarea id="message" name="message" rows="5" placeholder="Popište svou akci..."></textarea>
            </div>

            <button type="submit" class="btn btn--primary">Odeslat poptávku →</button>
          </form>
        </div>

        <div class="contact__info reveal">
          <div class="info-card">
            <h3>Kontaktní údaje</h3>
            <div class="info-item">
              <span class="info-icon">✉</span>
              <a href="mailto:info@shsheretik.cz">info@shsheretik.cz</a>
            </div>
            <div class="info-item">
              <span class="info-icon">◈</span>
              <p>Mohelnice, Česká republika</p>
            </div>
          </div>

          <div class="info-card">
            <h3>Technické info</h3>
            <ul class="info-list">
              <li>Prostor pro vystoupení: min. 6×6 m</li>
              <li>Rovný povrch (tráva nebo dlažba)</li>
              <li>Přístup k elektřině</li>
              <li>Možnost převlékání</li>
            </ul>
          </div>

          <div class="info-card">
            <h3>Sledujte nás</h3>
            <div class="info-social">
              <a href="#" aria-label="Facebook">FB</a>
              <a href="#" aria-label="Instagram">IG</a>
              <a href="#" aria-label="YouTube">YT</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  .scena-page-hero {
    padding: clamp(5rem, 12vw, 8rem) 0 3rem;
    background:
      linear-gradient(180deg, rgba(10,10,10,0.9), var(--bg)),
      url('/images/hero-1.jpeg') center/cover;
    border-bottom: 1px solid var(--border);
  }

  .page-title { font-size: clamp(2.5rem, 7vw, 5rem); margin-bottom: 0.5rem; }
  .page-subtitle { font-size: 1.15rem; color: var(--text-secondary); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    max-width: 1100px;
  }

  .contact__heading { margin-bottom: 2rem; }

  .contact__form {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2.5rem;
  }

  .form-group { margin-bottom: 1.5rem; }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color 0.3s var(--ease);
    border-radius: 0;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--red);
  }

  .form-group textarea { resize: vertical; min-height: 120px; }

  .contact__info { display: flex; flex-direction: column; gap: 1.5rem; }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2rem;
  }

  .info-card h3 {
    font-size: 1.1rem;
    margin-bottom: 1.2rem;
    color: var(--gold);
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .info-icon { color: var(--red); font-weight: 700; font-size: 1.2rem; }

  .info-item a { color: var(--text); }
  .info-item a:hover { color: var(--red); }

  .info-list { list-style: none; }

  .info-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .info-list li:last-child { border-bottom: none; }

  .info-social { display: flex; gap: 1rem; }

  .info-social a {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    transition: all 0.3s var(--ease);
  }

  .info-social a:hover {
    border-color: var(--red);
    color: var(--red);
  }

  @media (max-width: 900px) {
    .contact__grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
