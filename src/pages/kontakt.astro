---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
---

<ScenaLayout title="Kontakt">
  <ScenaHeader />
  <main>
    <section class="scena-page-hero">
      <div class="container">
        <p class="section-label reveal">Kontakt</p>
        <h1 class="page-title reveal">KONTAKT</h1>
        <p class="page-subtitle reveal">Domluvte si s námi vystoupení</p>
      </div>
    </section>

    <section class="section">
      <div class="container contact__grid">
        <div class="contact__main reveal">
          <h2 class="contact__heading">Poptat vystoupení</h2>
          <p class="contact__intro">
            Dle vašich potřeb jsme schopni připravit vystoupení pro městské slavnosti,
            historické dny, plesy, firemní večírky, oslavy narozenin, dětské tábory
            a také program pro základní školy.
          </p>
          <p class="contact__intro">
            Naše hlavní sídlo je v Mohelnici, ale rádi cestujeme po celé České republice.
          </p>

          <div class="contact__box">
            <h3 class="contact__box-title">Napište nám</h3>
            <p class="contact__box-text">
              Kontaktní údaje skupiny vám doplníme – pro domluvení vystoupení
              nás můžete kontaktovat přes naše sociální sítě.
            </p>
            <div class="contact__social">
              <a href="#" class="contact__social-link" aria-label="Facebook">FB</a>
              <a href="#" class="contact__social-link" aria-label="Instagram">IG</a>
              <a href="#" class="contact__social-link" aria-label="YouTube">YT</a>
            </div>
          </div>
        </div>

        <aside class="contact__side reveal">
          <div class="info-card">
            <h3 class="info-card__title">Kde nás najdete</h3>
            <p class="info-card__text">Mohelnice, Česká republika</p>
          </div>

          <div class="info-card">
            <h3 class="info-card__title">Co umíme</h3>
            <ul class="info-list">
              <li>Městské slavnosti a historické dny</li>
              <li>Plesy a firemní večírky</li>
              <li>Oslavy narozenin</li>
              <li>Dětské tábory a program pro ZŠ</li>
            </ul>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  .scena-page-hero {
    padding: clamp(5rem, 12vw, 8rem) 0 3rem;
    background:
      linear-gradient(180deg, rgba(10,10,10,0.9), var(--bg)),
      url('/images/hero-1.jpeg') center/cover;
    border-bottom: 1px solid var(--border);
  }

  .page-title { font-size: clamp(2.5rem, 7vw, 5rem); margin-bottom: 0.5rem; }
  .page-subtitle { font-size: 1.15rem; color: var(--text-secondary); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    max-width: 1100px;
  }

  .contact__heading { margin-bottom: 1.5rem; }

  .contact__intro {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    border-left: 4px solid var(--red);
    padding-left: 1.5rem;
  }

  .contact__box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2.5rem;
    margin-top: 2rem;
  }

  .contact__box-title {
    font-size: 1.2rem;
    margin-bottom: 1rem;
    color: var(--gold);
  }

  .contact__box-text {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .contact__social { display: flex; gap: 1rem; }

  .contact__social-link {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    transition: all 0.3s var(--ease);
  }

  .contact__social-link:hover {
    border-color: var(--red);
    color: var(--red);
  }

  .contact__side { display: flex; flex-direction: column; gap: 1.5rem; }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2rem;
  }

  .info-card__title {
    font-size: 1.1rem;
    margin-bottom: 1.2rem;
    color: var(--gold);
  }

  .info-card__text { color: var(--text-secondary); }

  .info-list { list-style: none; }

  .info-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.95rem;
    position: relative;
    padding-left: 1.2rem;
  }

  .info-list li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: var(--red);
    font-size: 0.7rem;
    top: 0.9rem;
  }

  .info-list li:last-child { border-bottom: none; }

  @media (max-width: 900px) {
    .contact__grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
