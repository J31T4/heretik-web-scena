---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaPageHero from '../components/ScenaPageHero.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
import BookingButton from '../components/BookingButton.astro';
import Picture from '../components/Picture.astro';
import Blade from '../components/Blade.astro';
import { cs } from '../utils/typo.js';

const stories = [
  {
    title: 'Husitská epopej',
    lead: 'Několik scén odehrávajících se v naší známé historické Praze – každý titul je zaměřený na jiné téma.',
    episodes: [
      'O papežských vyslancích, prodávajících odpustky',
      'Kazatelé, snažící se získat nové spojence',
      'Zvláštní posel, dávající za vyučenou hříšníkům',
    ],
  },
  {
    title: 'Pražské povídky',
    lead: 'Povídky o životě Pražanů.',
    episodes: [
      'Jak žoldnéř na hlupácích vydělal',
      'O princezně, která tři mladíky k hrozné zkáze přivedla',
    ],
  },
];

const performances = [
  {
    title: 'Městské slavnosti a historické dny',
    description: 'Vystoupení, která oživí atmosféru vaší akce a přenesou diváky do minulosti.',
    details: 'Historický a scénický šerm s vlastní choreografií',
    image: '/images/opt/gallery-13',
    w: 1400,
    h: 646,
  },
  {
    title: 'Plesy a firemní večírky',
    description: 'Exkluzivní šermířský program pro reprezentativní i zábavné večery.',
    details: 'Elegantní vystoupení přímo na míru vaší akci',
    image: '/images/opt/gallery-19',
    w: 1400,
    h: 788,
  },
  {
    title: 'Oslavy narozenin',
    description: 'Neobvyklý zážitek, který udělá z vaší oslavy nezapomenutelnou událost.',
    details: 'Přizpůsobíme program oslavě',
    image: '/images/opt/gallery-5',
    w: 1050,
    h: 1400,
  },
  {
    title: 'Dětské tábory a školy',
    description: 'Program pro děti, který je nejen pobaví, ale také přiučí novým věcem o historii.',
    details: 'Vzdělávací a zábavný program pro ZŠ i tábory',
    image: '/images/opt/gallery-25',
    w: 1400,
    h: 932,
  },
];
---

<ScenaLayout
  title="Co nabízíme"
  description="Vystoupení na míru: městské slavnosti, historické dny, plesy, firemní večírky, oslavy narozenin i program pro školy a tábory."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaPageHero
      variant="standard"
      act="I. dějství · Co nabízíme"
      label="Co děláme"
      title="CO NABÍZÍME"
      subtitle="Vystoupení dle vašich potřeb"
      image={{
        jpg: '/images/opt/gallery-16.jpg',
        alt: '',
        position: 'mid',
        w: 1400,
        h: 646,
      }}
    />

    <section class="section scena-scenes act-section">
      <span class="act-node" aria-hidden="true"></span>
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker"><span class="kicker__act">II. dějství</span><span class="kicker__label">Naše scény</span></p>
          <h2 class="section-title">Naše povídky</h2>
          <Blade />
        </div>

        <div class="scenes__grid" data-reveal-group>
          {stories.map((story) => (
            <article class:list={['scene-card', 'paper']} data-reveal>
              <div class="scene-card__top">
                <span class="scene-card__tag">Povídky</span>
                <h3 class="scene-card__title">{story.title}</h3>
                <Blade center />
              </div>
              <p class="scene-card__lead">{cs(story.lead)}</p>
              <ol class="scene-card__list">
                {story.episodes.map((episode, episodeIndex) => (
                  <li>
                    <span class="scene-card__num" aria-hidden="true">
                      {String(episodeIndex + 1).padStart(2, '0')}
                    </span>
                    <span>{cs(episode)}</span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--tint scena-perf">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker"><span class="kicker__act">III. dějství</span><span class="kicker__label">Příležitosti</span></p>
          <h2 class="section-title" data-reveal="curtain">Vystoupení pro vaši akci</h2>
          <p class="section-subtitle">{cs('Dle vašich potřeb jsme schopni připravit vystoupení pro městské slavnosti, historické dny a v neposlední řadě také obstaráme program pro plesy, firemní večírky, oslavy narozenin, dětské tábory a dokonce i program pro ZŠ, který děti nejen pobaví, ale také přiučí novým věcem o historii.')}</p>
        </div>

        <div class="perf__list" data-reveal-group>
          {performances.map((perf, i) => (
            <article class:list={['perf__card', { 'perf__card--flip': i % 2 === 1 }]} data-reveal>
              <figure class="perf__image">
                <Picture
                  src={`${perf.image}.jpg`}
                  alt={perf.title}
                  width={perf.w}
                  height={perf.h}
                  loading="lazy"
                  sizes="(max-width: 1000px) 100vw, 420px"
                />
              </figure>
              <div class="perf__body">
                <span class="perf__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="perf__title">{cs(perf.title)}</h3>
                <p class="perf__desc">{cs(perf.description)}</p>
                <p class="perf__details">{cs(perf.details)}</p>
                <BookingButton variant="ghost" />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  /* --- Karty povídek --- */
  .scenes__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
  }

  .scene-card {
    position: relative;
    padding: clamp(2.2rem, 4vw, 3.2rem) clamp(1.6rem, 3.4vw, 2.8rem) clamp(1.8rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(22, 18, 14, 0.5);
    box-shadow: var(--shadow-1);
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease);
  }
  /* Vnitřní rámeček plakátu */
  .scene-card::after {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid var(--line-2);
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .scene-card:hover { transform: translateY(-4px) rotate(-0.25deg); box-shadow: var(--shadow-2), var(--shadow-red); }
  }

  .scene-card__top {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .scene-card__tag {
    background: var(--color-paper-crimson);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem 0.35rem 1.2rem;
  }
  .scene-card__title { font-size: clamp(1.8rem, 3.4vw, 2.5rem); }

  .scene-card__lead {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 auto var(--sp-4);
    max-width: 44ch;
  }

  .scene-card__list { position: relative; z-index: 1; display: flex; flex-direction: column; }
  .scene-card__list li {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding: 0.8rem 0;
    border-top: 1px dashed var(--line-2);
    font-size: 0.97rem;
    color: var(--color-paper-ink);
  }
  .scene-card__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-paper-crimson);
    flex-shrink: 0;
    min-width: 2ch;
  }

  /* --- Představení na míru --- */
  .perf__list { display: flex; flex-direction: column; gap: var(--sp-6); }

  .perf__card {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 0;
    background: var(--bg-2);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color var(--t-med) var(--ease), box-shadow var(--t-med) var(--ease), transform var(--t-med) var(--ease-out);
  }
  .perf__card:focus-within {
    border-color: rgba(228, 6, 7, 0.5);
    box-shadow: var(--shadow-1);
    transform: translateY(-4px);
  }
  @media (hover: hover) and (pointer: fine) {
    .perf__card:hover {
      border-color: rgba(228, 6, 7, 0.5);
      box-shadow: var(--shadow-1), var(--shadow-red);
      transform: translateY(-4px);
    }
  }

  .perf__card--flip { grid-template-columns: 1fr 420px; }
  .perf__card--flip .perf__image { order: 2; }

  .perf__image {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .perf__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(0.9) contrast(1.05);
    transition: transform var(--dur-4) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .perf__card:hover .perf__image :global(img) { transform: scale(1.06); }
  }

  .perf__body {
    padding: var(--sp-6);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .perf__num {
    position: absolute;
    top: var(--sp-5);
    right: var(--sp-6);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.4rem;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.25);
    pointer-events: none;
    user-select: none;
  }
  @supports not (-webkit-text-stroke: 1px #000) {
    .perf__num { color: var(--ink-3); }
  }
  @media (hover: hover) and (pointer: fine) {
    .perf__card:hover .perf__num { -webkit-text-stroke-color: rgba(255, 74, 75, 0.75); }
  }

  .perf__title {
    margin-bottom: var(--sp-4);
    padding-right: 4.5rem;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
  }
  .perf__desc { margin-bottom: var(--sp-4); }
  .perf__details {
    font-size: 0.92rem;
    color: var(--gold);
    margin-bottom: var(--sp-5);
  }
  .perf__body :global(.btn) { margin-top: auto; }

  @media (max-width: 1000px) {
    .perf__card, .perf__card--flip { grid-template-columns: 1fr; }
    .perf__card--flip .perf__image { order: 0; }
    .perf__image { aspect-ratio: 16 / 9; }
    .perf__body { padding: var(--sp-6); }
  }
  @media (max-width: 900px) {
    .scenes__grid { grid-template-columns: 1fr; }
  }
</style>
