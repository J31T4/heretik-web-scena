---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaPageHero from '../components/ScenaPageHero.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
import ScenaCTA from '../components/ScenaCTA.astro';
import Picture from '../components/Picture.astro';
import Blade from '../components/Blade.astro';
import { cs } from '../utils/typo.js';

const stories = [
  {
    title: 'Husitská epopej',
    lead: 'Několik scén odehrávajících se v naší známé historické Praze – každý titul je zaměřený na jiné téma.',
    episodes: [
      'O papežských vyslancích prodávajících odpustky',
      'Kazatelé snažící se získat nové spojence',
      'Zvláštní posel dávající za vyučenou hříšníkům',
    ],
  },
  {
    title: 'Pražské povídky',
    lead: 'Povídky o životě Pražanů.',
    episodes: [
      'Jak žoldnéř na hlupácích vydělal',
      'O princezně, která tři mladíky k hrozné zkáze přivedla',
    ],
  },
];

const performances = [
  {
    title: 'Městské slavnosti a historické dny',
    description: 'Vystoupení, která oživí atmosféru vaší akce a přenesou diváky do minulosti.',
    details: 'Historický a scénický šerm s vlastní choreografií',
    alt: 'Šermířské vystoupení před diváky na městském nádvoří',
    image: '/images/opt/gallery-13',
    w: 1400,
    h: 646,
  },
  {
    title: 'Plesy a firemní večírky',
    description: 'Exkluzivní šermířský program pro reprezentativní i zábavné večery.',
    details: 'Elegantní vystoupení přímo na míru vaší akci',
    alt: 'Večerní vystoupení na pódiu před publikem na náměstí',
    image: '/images/opt/gallery-19',
    w: 1400,
    h: 788,
  },
  {
    title: 'Oslavy narozenin',
    description: 'Neobvyklý zážitek, který udělá z vaší oslavy nezapomenutelnou událost.',
    details: 'Přizpůsobíme program oslavě',
    alt: 'Dobové ležení se stanem a postavou v červeném kostýmu',
    image: '/images/opt/gallery-5',
    w: 1050,
    h: 1400,
    portrait: true,
  },
  {
    title: 'Dětské tábory a školy',
    description: 'Program pro děti, který je nejen pobaví, ale také přiučí novým věcem o historii.',
    details: 'Vzdělávací a zábavný program pro ZŠ i tábory',
    alt: 'Šermíř v akrobatickém pádu a soupeř s mečem v humorné scéně',
    image: '/images/opt/gallery-25',
    w: 1400,
    h: 932,
  },
];
---

<ScenaLayout
  title="Vystoupení"
  image={{ src: '/images/opt/gallery-16.jpg', width: 1400, height: 646, alt: 'Šermířské vystoupení SHŠ Heretik před diváky' }}
  description="Vystoupení na míru: městské slavnosti, historické dny, plesy, firemní večírky, oslavy narozenin i program pro školy a tábory."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaPageHero
      variant="standard"
      act="I. dějství · Co nabízíme"
      label="Co nabízíme"
      title="Vystoupení"
      subtitle="Vystoupení dle vašich potřeb"
      image={{
        jpg: '/images/opt/gallery-16.jpg',
        alt: '',
        position: 'mid',
        w: 1400,
        h: 646,
      }}
    />

    <section class="section scena-scenes act-section">
      <span class="act-node" aria-hidden="true"></span>
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker"><span class="kicker__act">1. scéna</span><span class="kicker__label">Repertoár</span></p>
          <h2 class="section-title">Naše povídky</h2>
          <Blade />
        </div>

        <div class="scenes__grid" data-reveal-group>
          {stories.map((story) => (
            <article class:list={['scene-card', 'paper']} data-reveal>
              <div class="scene-card__top">
                <span class="scene-card__tag">Povídky</span>
                <h3 class="scene-card__title">{story.title}</h3>
                <Blade center />
              </div>
              <p class="scene-card__lead">{cs(story.lead)}</p>
              <ol class="scene-card__list">
                {story.episodes.map((episode, episodeIndex) => (
                  <li>
                    <span class="scene-card__num" aria-hidden="true">
                      {String(episodeIndex + 1).padStart(2, '0')}
                    </span>
                    <span>{cs(episode)}</span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--tint scena-perf act-section">
      <span class="act-node" aria-hidden="true"></span>
      <div class="container">
        <div class="section-head section-head--split">
          <div class="section-head__main reveal">
            <p class="kicker"><span class="kicker__act">2. scéna</span><span class="kicker__label">Příležitosti</span></p>
            <h2 class="section-title" data-reveal="curtain">Pro vaši akci</h2>
          </div>
          <div class="section-head__aside reveal">
            <p class="section-subtitle">{cs('Vystoupení připravíme dle vašich potřeb – od městských slavností a historických dnů po program pro základní školy.')}</p>
          </div>
        </div>

        <div class="perf__grid" data-reveal-group>
          {performances.map((perf, i) => (
            <article class="perf__card" data-reveal>
              <figure class="perf__image">
                <Picture
                  src={`${perf.image}.jpg`}
                  alt={perf.alt}
                  width={perf.w}
                  height={perf.h}
                  loading="lazy"
                  sizes="(max-width: 760px) 100vw, 560px"
                  imgClass={perf.portrait ? 'perf__img--pos' : undefined}
                />
                <span class="perf__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </figure>
              <div class="perf__body">
                <h3 class="perf__title">{cs(perf.title)}</h3>
                <p class="perf__desc">{cs(perf.description)}</p>
                <p class="perf__details"><span aria-hidden="true">◆</span> {cs(perf.details)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ScenaCTA />
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  /* --- Karty povídek --- */
  .scenes__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
  }

  .scene-card {
    position: relative;
    padding: clamp(2.2rem, 4vw, 3.2rem) clamp(1.6rem, 3.4vw, 2.8rem) clamp(1.8rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(22, 18, 14, 0.5);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), var(--shadow-card);
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease);
  }
  /* Vnitřní rámeček plakátu */
  .scene-card::after {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid var(--line-2);
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .scene-card:hover { transform: translateY(-4px) rotate(-0.25deg); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), var(--shadow-card-hover); }
  }

  .scene-card__top {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .scene-card__tag {
    background: var(--color-paper-crimson);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem 0.35rem 1.2rem;
  }
  .scene-card__title { font-size: clamp(2rem, 3.8vw, 2.9rem); line-height: 1.08; }

  .scene-card__lead {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 auto var(--sp-4);
    max-width: 44ch;
  }

  .scene-card__list { position: relative; z-index: 1; display: flex; flex-direction: column; }
  .scene-card__list li {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding: 0.8rem 0;
    border-top: 1px dashed var(--line-2);
    font-size: 0.97rem;
    color: var(--color-paper-ink);
  }
  .scene-card__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-paper-crimson);
    flex-shrink: 0;
    min-width: 2ch;
  }

  /* --- Příležitosti: mřížka 2×2 fotokaret --- */
  .perf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6);
  }

  .perf__card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    box-shadow: var(--edge-light), var(--shadow-card);
    overflow: hidden;
    transition: border-color var(--t-med) var(--ease), box-shadow var(--t-med) var(--ease), transform var(--t-med) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .perf__card:hover {
      border-color: rgba(228, 6, 7, 0.5);
      box-shadow: var(--edge-light), var(--shadow-card-hover);
      transform: translateY(-4px);
    }
  }

  .perf__image {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  /* spodní závoj — fotka plynule přechází do těla karty */
  .perf__image::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(6, 6, 6, 0.5) 0%, transparent 32%, transparent 60%, var(--bg-2) 100%);
  }
  .perf__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(0.9) contrast(1.05);
    transition: transform var(--dur-4) var(--ease-out);
  }
  /* Portrétní gallery-5 v pásu 16:10 — výřez na postavu v červeném */
  .perf__image :global(img.perf__img--pos) { object-position: 50% 64%; }
  @media (hover: hover) and (pointer: fine) {
    .perf__card:hover .perf__image :global(img) { transform: scale(1.05); }
  }

  .perf__num {
    position: absolute;
    z-index: 2;
    top: clamp(0.5rem, 1.2vw, 0.9rem);
    right: clamp(1rem, 2vw, 1.5rem);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.2rem, 5.5vw, 4.6rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.75);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    user-select: none;
    font-variant-numeric: lining-nums tabular-nums;
    transition: -webkit-text-stroke-color var(--t-med) var(--ease);
  }
  @supports not (-webkit-text-stroke: 1px #000) {
    .perf__num { color: var(--ink); }
  }
  @media (hover: hover) and (pointer: fine) {
    .perf__card:hover .perf__num { -webkit-text-stroke-color: var(--accent-text); }
  }

  .perf__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--sp-4) clamp(1.4rem, 2.6vw, 2.2rem) clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .perf__title {
    margin-bottom: var(--sp-3);
    font-size: clamp(1.45rem, 2.4vw, 1.95rem);
  }
  /* Tenká karmínovo-zlatá linka pod titulem, na hover se prodlouží */
  .perf__title::after {
    content: '';
    display: block;
    width: 4.5rem;
    height: 2px;
    margin-top: var(--sp-3);
    background: linear-gradient(90deg, var(--crimson), var(--gold));
    transform: scaleX(0.45);
    transform-origin: left;
    transition: transform var(--dur-4) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .perf__card:hover .perf__title::after { transform: scaleX(1); }
  }
  .perf__desc { margin-bottom: var(--sp-4); }
  .perf__details {
    margin-top: auto;
    padding-top: var(--sp-4);
    border-top: 1px dashed var(--line-2);
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    font-size: 0.92rem;
    color: var(--gold);
  }
  .perf__details span { font-size: 0.55rem; color: var(--crimson); }

  @media (max-width: 760px) {
    .perf__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .scenes__grid { grid-template-columns: 1fr; }
  }
</style>
