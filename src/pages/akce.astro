---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
import { asset, page } from '../utils/paths.js';

const performances = [
  {
    title: 'Městské slavnosti a historické dny',
    description: 'Vystoupení, která oživí atmosféru vaší akce a přenesou diváky do minulosti.',
    details: 'Historický a scénický šerm s vlastní choreografií',
    image: asset('/images/gallery-4.jpeg'),
  },
  {
    title: 'Plesy a firemní večírky',
    description: 'Exkluzivní šermířský program pro reprezentativní i zábavné večery.',
    details: 'Elegantní vystoupení přímo na míru vaší akci',
    image: asset('/images/gallery-5.jpeg'),
  },
  {
    title: 'Oslavy narozenin',
    description: 'Neobvyklý zážitek, který udělá z vaší oslavy nezapomenutelnou událost.',
    details: 'Přizpůsobíme program oslavě',
    image: asset('/images/gallery-6.jpeg'),
  },
  {
    title: 'Dětské tábory a školy',
    description: 'Program pro děti, které nejen pobaví, ale také přiučí novým věcem o historii.',
    details: 'Vzdělávací a zábavný program pro ZŠ i tábory',
    image: asset('/images/gallery-7.jpeg'),
  },
];
---

<ScenaLayout title="Co nabízíme">
  <ScenaHeader />
  <main>
    <section class="scena-page-hero">
      <div class="container">
        <p class="section-label reveal">Co děláme</p>
        <h1 class="page-title reveal">CO NABÍZÍME</h1>
        <p class="page-subtitle reveal">Vystoupení dle vašich potřeb</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="section-label reveal">Naše scény</p>
        <h2 class="section-title reveal">Programy a povídky</h2>
        <div class="divider reveal"><span></span></div>

        <div class="shows__scenes">
          <article class="scene-card reveal">
            <div class="scene-card__top">
              <span class="scene-card__tag">Program</span>
              <h3 class="scene-card__title">Husitská epopej</h3>
            </div>
            <p class="scene-card__lead">
              Několik scén odehrávajících se v naší známé historické Praze –
              každý titul je zaměřený na jiné téma.
            </p>
            <ul class="scene-card__list">
              <li>
                <span class="scene-card__num">01</span>
                <span>Papežští vyslanci, kteří prodávají odpustky</span>
              </li>
              <li>
                <span class="scene-card__num">02</span>
                <span>Kazatelé, kteří se snaží získat nové spojence</span>
              </li>
              <li>
                <span class="scene-card__num">03</span>
                <span>Zvláštní posel, který dá za vyučenou hříšníkům</span>
              </li>
            </ul>
          </article>

          <article class="scene-card reveal">
            <div class="scene-card__top">
              <span class="scene-card__tag">Povídky</span>
              <h3 class="scene-card__title">Pražské povídky</h3>
            </div>
            <p class="scene-card__lead">
              Povídky o životě Pražanů.
            </p>
            <ul class="scene-card__list">
              <li>
                <span class="scene-card__num">01</span>
                <span>Jak žoldnéř na hlupácích vydělal</span>
              </li>
              <li>
                <span class="scene-card__num">02</span>
                <span>O princezně, která tři mladíky k hrozné zkáze přivedla</span>
              </li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--card">
      <div class="container">
        <p class="intro reveal">
          Dle vašich potřeb jsme schopni připravit vystoupení pro městské slavnosti,
          historické dny a v neposlední řadě také obstaráme program pro plesy,
          firemní večírky, oslavy narozenin, dětské tábory a dokonce i program
          pro ZŠ, který děti nejen pobaví, ale také přiučí novým věcem o historii.
        </p>

        <div class="perf__list">
          {performances.map((perf, i) => (
            <article class="perf__card reveal">
              <div class="perf__image">
                <img src={perf.image} alt={perf.title} loading="lazy" />
              </div>
              <div class="perf__body">
                <span class="perf__num">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="perf__title">{perf.title}</h2>
                <p class="perf__desc">{perf.description}</p>
                <p class="perf__details">{perf.details}</p>
                <a href={page('/kontakt')} class="btn btn--ghost">Poptat vystoupení →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  .scena-page-hero {
    padding: clamp(5rem, 12vw, 8rem) 0 3rem;
    background:
      linear-gradient(180deg, rgba(10,10,10,0.9), var(--bg)),
      url('/images/hero-1.jpeg') center/cover;
    border-bottom: 1px solid var(--border);
  }

  .page-title { font-size: clamp(2.5rem, 7vw, 5rem); margin-bottom: 0.5rem; }
  .page-subtitle { font-size: 1.15rem; color: var(--text-secondary); }

  /* Karty scén – Husitská epopej + Pražské povídky */
  .shows__scenes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .scene-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2.5rem 2.5rem 2rem;
    overflow: hidden;
    transition: all 0.4s var(--ease);
    display: flex;
    flex-direction: column;
  }

  .scene-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--red), var(--gold));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }

  .scene-card:hover {
    border-color: var(--red);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
    transform: translateY(-4px);
  }

  .scene-card:hover::before { transform: scaleX(1); }

  .scene-card__top {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .scene-card__tag {
    background: var(--red);
    color: white;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    flex-shrink: 0;
  }

  .scene-card__title {
    font-size: 1.6rem;
    color: var(--text);
  }

  .scene-card__lead {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    font-style: italic;
    padding-bottom: 1.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .scene-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .scene-card__list li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px dashed rgba(42, 42, 42, 0.6);
    font-size: 0.95rem;
    color: var(--text-secondary);
    transition: color 0.3s var(--ease);
  }

  .scene-card__list li:last-child { border-bottom: none; }

  .scene-card__list li:hover { color: var(--text); }

  .scene-card__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--red);
    flex-shrink: 0;
    min-width: 2ch;
  }

  @media (max-width: 900px) {
    .shows__scenes { grid-template-columns: 1fr; }
  }

  .intro {
    max-width: 800px;
    font-size: 1.15rem;
    line-height: 1.8;
    margin-bottom: 3.5rem;
    border-left: 4px solid var(--red);
    padding-left: 1.5rem;
  }

  .perf__list { display: flex; flex-direction: column; gap: 2.5rem; }

  .perf__card {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 2.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: all 0.4s var(--ease);
    overflow: hidden;
  }

  .perf__card:hover {
    border-color: var(--red);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .perf__image { aspect-ratio: 16/10; overflow: hidden; }

  .perf__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .perf__card:hover .perf__image img { transform: scale(1.06); }

  .perf__body { padding: 2.5rem; position: relative; }

  .perf__num {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.2rem;
    color: var(--border);
  }

  .perf__card:hover .perf__num { color: var(--gold); }

  .perf__title { margin-bottom: 1rem; }

  .perf__desc { margin-bottom: 1rem; }

  .perf__details {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--gold);
    margin-bottom: 1.8rem;
  }

  @media (max-width: 900px) {
    .perf__card { grid-template-columns: 1fr; }
    .perf__image { aspect-ratio: 16/9; }
  }
</style>
