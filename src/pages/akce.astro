---
import ScenaLayout from '../layouts/ScenaLayout.astro';
import ScenaHeader from '../components/ScenaHeader.astro';
import ScenaPageHero from '../components/ScenaPageHero.astro';
import ScenaFooter from '../components/ScenaFooter.astro';
import BookingButton from '../components/BookingButton.astro';
import { asset } from '../utils/paths.js';
import { cs } from '../utils/typo.js';

const stories = [
  {
    title: 'Husitská epopej',
    lead: 'Několik scén odehrávajících se v naší známé historické Praze – každý titul je zaměřený na jiné téma.',
    episodes: [
      'O papežských vyslancích, prodávajících odpustky',
      'Kazatelé, snažící se získat nové spojence',
      'Zvláštní posel, dávající za vyučenou hříšníkům',
    ],
  },
  {
    title: 'Pražské povídky',
    lead: 'Povídky o životě Pražanů.',
    episodes: [
      'Jak žoldnéř na hlupácích vydělal',
      'O princezně, která tři mladíky k hrozné zkáze přivedla',
    ],
  },
];

const performances = [
  {
    title: 'Městské slavnosti a historické dny',
    description: 'Vystoupení, která oživí atmosféru vaší akce a přenesou diváky do minulosti.',
    details: 'Historický a scénický šerm s vlastní choreografií',
    image: '/images/opt/gallery-4',
    w: 1400,
    h: 1050,
  },
  {
    title: 'Plesy a firemní večírky',
    description: 'Exkluzivní šermířský program pro reprezentativní i zábavné večery.',
    details: 'Elegantní vystoupení přímo na míru vaší akci',
    image: '/images/opt/gallery-7',
    w: 1400,
    h: 1400,
  },
  {
    title: 'Oslavy narozenin',
    description: 'Neobvyklý zážitek, který udělá z vaší oslavy nezapomenutelnou událost.',
    details: 'Přizpůsobíme program oslavě',
    image: '/images/opt/gallery-5',
    w: 1050,
    h: 1400,
  },
  {
    title: 'Dětské tábory a školy',
    description: 'Program pro děti, které nejen pobaví, ale také přiučí novým věcem o historii.',
    details: 'Vzdělávací a zábavný program pro ZŠ i tábory',
    image: '/images/opt/gallery-3',
    w: 1400,
    h: 934,
  },
];
---

<ScenaLayout
  title="Co nabízíme"
  description="Vystoupení na míru: městské slavnosti, historické dny, plesy, firemní večírky, oslavy narozenin i program pro školy a tábory."
>
  <ScenaHeader />
  <main id="obsah">
    <ScenaPageHero
      variant="standard"
      act="I. dějství · Co nabízíme"
      label="Co děláme"
      title="CO NABÍZÍME"
      subtitle="Vystoupení dle vašich potřeb"
      image={{
        webp: asset('/images/opt/gallery-3.webp'),
        jpg: asset('/images/opt/gallery-3.jpg'),
        alt: '',
        position: 'high',
      }}
    />

    <section class="section scena-scenes act-section">
      <span class="act-node" aria-hidden="true"></span>
      <div class="container">
        <p class="act-label reveal">II. dějství</p>
        <div class="section-head reveal">
          <p class="section-label">Naše scény</p>
          <h2 class="section-title">Naše povídky</h2>
        </div>

        <div class="scenes__grid">
          {stories.map((story, storyIndex) => (
            <article
              class:list={['scene-card', 'reveal', { 'reveal--delay-120': storyIndex > 0 }]}
            >
              <div class="scene-card__top">
                <span class="scene-card__tag">Povídky</span>
                <h3 class="scene-card__title">{story.title}</h3>
              </div>
              <p class="scene-card__lead" set:html={cs(story.lead)} />
              <ol class="scene-card__list">
                {story.episodes.map((episode, episodeIndex) => (
                  <li>
                    <span class="scene-card__num">
                      {String(episodeIndex + 1).padStart(2, '0')}
                    </span>
                    <span set:html={cs(episode)} />
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--tint scena-perf">
      <div class="container">
        <p class="act-label reveal">III. dějství</p>
        <div class="section-head reveal">
          <p class="section-label">Příležitosti</p>
          <h2 class="section-title">Vystoupení pro vaši akci</h2>
          <p class="section-subtitle" set:html={cs('Dle vašich potřeb jsme schopni připravit vystoupení pro městské slavnosti, historické dny a v neposlední řadě také obstaráme program pro plesy, firemní večírky, oslavy narozenin, dětské tábory a dokonce i program pro ZŠ, který děti nejen pobaví, ale také přiučí novým věcem o historii.')} />
        </div>

        <div class="perf__list">
          {performances.map((perf, i) => (
            <article class:list={['perf__card', 'reveal', { 'perf__card--flip': i % 2 === 1 }]}>
              <figure class="perf__image">
                <picture>
                  <source srcset={asset(`${perf.image}.webp`)} type="image/webp" />
                  <img
                    src={asset(`${perf.image}.jpg`)}
                    alt={perf.title}
                    loading="lazy"
                    decoding="async"
                    width={perf.w}
                    height={perf.h}
                  />
                </picture>
              </figure>
              <div class="perf__body">
                <span class="perf__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="perf__title" set:html={cs(perf.title)} />
                <p class="perf__desc" set:html={cs(perf.description)} />
                <p class="perf__details" set:html={cs(perf.details)} />
                <BookingButton variant="ghost" />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <ScenaFooter />
</ScenaLayout>

<style>
  /* --- Karty povídek --- */
  .scenes__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
  }

  .scene-card {
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--line);
    padding: var(--sp-7) var(--sp-6) var(--sp-6);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .scene-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--crimson), rgba(178, 175, 63, 0.7));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }
  .scene-card:hover::before,
  .scene-card:focus-within::before { transform: scaleX(1); }

  .scene-card__top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }
  .scene-card__tag {
    background: var(--crimson);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    flex-shrink: 0;
  }
  .scene-card__title { font-size: 1.55rem; }

  .scene-card__lead {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-2);
    font-style: italic;
    padding-bottom: var(--sp-5);
    margin-bottom: var(--sp-3);
    border-bottom: 1px solid var(--line);
  }

  .scene-card__list { display: flex; flex-direction: column; }
  .scene-card__list li {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding: 0.75rem 0;
    border-bottom: 1px dashed rgba(242, 237, 228, 0.12);
    font-size: 0.95rem;
    color: var(--ink-2);
    transition: color var(--t-fast) var(--ease);
  }
  .scene-card__list li:last-child { border-bottom: none; }
  .scene-card__list li:hover { color: var(--ink); }
  .scene-card__num {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--crimson-bright);
    flex-shrink: 0;
    min-width: 2ch;
  }

  /* --- Představení na míru --- */
  .perf__list { display: flex; flex-direction: column; gap: var(--sp-6); }

  .perf__card {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 0;
    background: var(--bg-2);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color var(--t-med) var(--ease), box-shadow var(--t-med) var(--ease);
  }
  .perf__card:hover,
  .perf__card:focus-within {
    border-color: rgba(228, 6, 7, 0.5);
    box-shadow: var(--shadow-1);
  }

  .perf__card--flip { grid-template-columns: 1fr 420px; }
  .perf__card--flip .perf__image { order: 2; }

  .perf__image {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .perf__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(0.9) contrast(1.05);
    transition: transform var(--dur-4) var(--ease-out);
  }
  .perf__card:hover .perf__image img { transform: scale(1.06); }

  .perf__body {
    padding: var(--sp-6);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .perf__num {
    position: absolute;
    top: var(--sp-5);
    right: var(--sp-6);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.4rem;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.25);
    pointer-events: none;
    user-select: none;
  }
  @supports not (-webkit-text-stroke: 1px #000) {
    .perf__num { color: var(--ink-3); }
  }
  .perf__card:hover .perf__num { -webkit-text-stroke-color: rgba(255, 74, 75, 0.75); }

  .perf__title {
    margin-bottom: var(--sp-4);
    padding-right: 4.5rem;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
  }
  .perf__desc { margin-bottom: var(--sp-4); }
  .perf__details {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--gold);
    margin-bottom: var(--sp-5);
  }
  .perf__body .btn { margin-top: auto; }

  @media (max-width: 1000px) {
    .perf__card, .perf__card--flip { grid-template-columns: 1fr; }
    .perf__card--flip .perf__image { order: 0; }
    .perf__image { aspect-ratio: 16 / 9; }
    .perf__body { padding: var(--sp-6); }
  }
  @media (max-width: 900px) {
    .scenes__grid { grid-template-columns: 1fr; }
  }
</style>
